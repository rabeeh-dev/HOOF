<% /* Computed variables */ const shortId=String(order._id).slice(-8).toUpperCase(); const orderDate=new
    Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric' , month: 'short' , year: 'numeric' }); const
    statusClass=order.status.toLowerCase().replace(/\s+/g, '-' ); /* Logic helpers */ const
    canCancel=['pending', 'processing' , 'placed' , 'confirmed' ].includes(order.status.toLowerCase()); const
    canReturn=['delivered', 'return requested', 'return approved', 'picked up'].includes(order.status.toLowerCase()); const canReview=['delivered', 'return requested', 'return approved', 'picked up', 'returned'].includes(order.status.toLowerCase());
    const isDelivered=order.status.toLowerCase()==='delivered' ; const
    isCancelled=order.status.toLowerCase()==='cancelled' ; const isReturned=['returned', 'return requested'
    ].includes(order.status.toLowerCase()); /* Stepper logic */ const steps=[ { label: "Confirmed" , icon: "fa-check" ,
    value: "Pending" }, { label: "Processing" , icon: "fa-cog" , value: "Processing" }, { label: "Shipped" ,
    icon: "fa-shipping-fast" , value: "Shipped" }, { label: "Out for Delivery" , icon: "fa-truck" ,
    value: "Out for Delivery" }, { label: "Delivered" , icon: "fa-box-open" , value: "Delivered" } ]; const
    statusMap={ 'pending' : 1, 'placed' : 1, 'confirmed' : 1, 'processing' : 2, 'shipped' : 3, 'out for delivery' :
    4, 'delivered' : 5, 'return requested' : 6, 'returned' : 7, 'cancelled' : 0 }; const normalizeStatus=(s)=> (s ||
    '').toLowerCase();
    const currentStatus = normalizeStatus(order.status);
    let currentStepInfo = statusMap[currentStatus] || 0;

    if (currentStatus === 'delivered') currentStepInfo = 5;
    %>

    <link rel="stylesheet" href="/user/css/user-profile.css" />
    <link rel="stylesheet" href="/user/css/orders.css" />
    <link rel="stylesheet" href="/user/css/order-detail.css" />

    <section class="profile-section">
        <div class="container">
            <div class="profile-header-title">
                <h1>Order Details</h1>
                <p>Review your order information</p>
            </div>

            <div class="profile-layout">

                <!-- SIDEBAR -->
                <div class="profile-sidebar">
                    <div class="profile-card">
                        <div class="profile-avatar-wrapper">
                            <div class="profile-avatar">
                                <% if (user.profileImage) { %>
                                    <img src="<%= user.profileImage %>" alt="Profile">
                                    <% } else { %>
                                        <span>
                                            <%= user.fullName.charAt(0) %>
                                        </span>
                                        <% } %>
                            </div>
                        </div>
                        <h3 class="profile-name">
                            <%= user.fullName %>
                        </h3>
                        <a href="/user/orders" class="btn-edit-profile"
                            style="text-decoration:none;display:flex;justify-content:center;align-items:center;gap:8px;">
                            <i class="fas fa-arrow-left"></i>Back to Orders
                        </a>

                        <!-- ORDER SUMMARY STRIP -->
                        <div style="border-top:1px solid rgba(0,0,0,0.1);padding-top:1.5rem;margin-top:1.5rem;">
                            <div class="sidebar-order-id">
                                <span
                                    style="font-size:0.75rem;color:#999;letter-spacing:0.1em;text-transform:uppercase;font-family:Roboto;font-weight:600;display:block;margin-bottom:0.4rem;">Order
                                    ID</span>
                                <span
                                    style="font-size:1rem;font-weight:800;color:var(--text-main);font-family:Roboto;">#
                                    <%= shortId %>
                                </span>
                            </div>

                            <div
                                style="display:flex;align-items:center;justify-content:center;gap:0.5rem;margin-top:0.8rem;">
                                <i class="fas fa-calendar" style="color:var(--accent);font-size:0.85rem;"></i>
                                <span style="font-size:0.85rem;color:#666;">
                                    <%= orderDate %>
                                </span>
                            </div>

                            <div style="margin-top:1rem;display:flex;justify-content:center;">
                                <span class="order-status-badge status-<%= statusClass %>"
                                    style="font-size:0.82rem;padding:7px 18px;">
                                    <span class="status-dot"></span>
                                    <%= order.status %>
                                </span>
                            </div>

                            <div style="margin-top:1.2rem;">
                                <span
                                    style="font-size:0.75rem;color:#999;text-transform:uppercase;letter-spacing:0.1em;font-family:Roboto;display:block;margin-bottom:0.4rem;">Order
                                    Total</span>
                                <span class="sidebar-order-total">₹<%= order.totalAmount.toLocaleString('en-IN') %>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- MAIN CONTENT -->
                <div class="profile-main">
                    <div class="tab-content-wrapper"
                        style="padding:2.5rem;display:flex;flex-direction:column;gap:2rem;">

                        <!-- BLOCK 1: ORDER STATUS AND PROGRESS -->
                        <div class="order-detail-block">
                            <div class="order-detail-block-header">
                                <div style="display:flex;align-items:center;gap:14px;">
                                    <% if (isReturned) { %>
                                        <div class="order-icon-box"
                                            style="background:rgba(243,156,18,0.1);color:#d68910;">
                                            <i class="fas fa-undo"></i>
                                        </div>
                                        <h4 style="font-size:1rem;font-weight:600;margin:0;">Return Tracking</h4>
                                        <% } else { %>
                                            <div class="order-icon-box">
                                                <i class="fas fa-map-marked-alt"></i>
                                            </div>
                                            <h4 style="font-size:1rem;font-weight:600;margin:0;">Order Tracking</h4>
                                            <% } %>
                                </div>
                            </div>

                            <div class="order-detail-block-body">
                                <% if (isCancelled) { %>
                                    <div class="cancelled-block">
                                        <i class="fas fa-times-circle"
                                            style="font-size:2.5rem;color:#dc3545;margin-bottom:0.8rem;"></i>
                                        <h3 style="color:#dc3545;font-size:1.1rem;margin-bottom:0.4rem;">Order Cancelled
                                        </h3>
                                        <% if (order.statusHistory && order.statusHistory.find(h=> h.status ===
                                            'Cancelled')?.note) { %>
                                            <p style="color:#888;font-size:0.9rem;margin:0;">
                                                <%= order.statusHistory.find(h=> h.status === 'Cancelled').note %>
                                            </p>
                                            <% } %>
                                    </div>
                                    <% } else if (isReturned) { %>
                                        <% /* Return tracking stepper logic */ const returnSteps=[ {
                                            label: "Return Requested" , icon: "fa-undo" , value: "Return Requested" }, {
                                            label: "Return Approved" , icon: "fa-check-circle" ,
                                            value: "Return Approved" }, { label: "Picked Up" , icon: "fa-box" ,
                                            value: "Picked Up" }, { label: "Refund Processed" , icon: "fa-wallet" ,
                                            value: "Returned" } ]; /* Determine current return step from statusHistory
                                            or status */ const returnStatusMap={ 'return requested' :
                                            1, 'return approved' : 2, 'picked up' : 3, 'returned' : 4 }; let
                                            currentReturnStep=returnStatusMap[currentStatus] || 1; /* Also check
                                            statusHistory for intermediate steps */ if (order.statusHistory &&
                                            order.statusHistory.length> 0) {
                                            order.statusHistory.forEach(h => {
                                            const histStep = returnStatusMap[(h.status || '').toLowerCase()];
                                            if (histStep && histStep > currentReturnStep) {
                                            currentReturnStep = histStep;
                                            }
                                            });
                                            }
                                            %>

                                            <!-- RETURN STEPPER -->
                                            <div class="order-stepper return-stepper">
                                                <% returnSteps.forEach((step, index)=> {
                                                    const stepNum = index + 1;
                                                    const isCompleted = stepNum < currentReturnStep; const
                                                        isActive=stepNum===currentReturnStep; %>
                                                        <div class="stepper-step">
                                                            <div
                                                                class="stepper-circle <%= isCompleted ? 'completed' : (isActive ? 'active' : '') %>">
                                                                <% if (isCompleted) { %>
                                                                    <i class="fas fa-check"
                                                                        style="font-size:0.75rem;"></i>
                                                                    <% } else { %>
                                                                        <i class="fas <%= step.icon %>"
                                                                            style="font-size:0.7rem;"></i>
                                                                        <% } %>
                                                            </div>
                                                            <div
                                                                class="stepper-label <%= isActive ? 'active' : (isCompleted ? 'completed' : '') %>">
                                                                <%= step.label %>
                                                            </div>
                                                        </div>
                                                        <% if (index < returnSteps.length - 1) { %>
                                                            <div
                                                                class="stepper-connector <%= isCompleted ? 'completed' : '' %>">
                                                            </div>
                                                            <% } %>
                                                                <% }) %>
                                            </div>

                                            <% /* Find the date of the latest return-related status */ const
                                                returnEntry=order.statusHistory && order.statusHistory.filter(h=>
                                                returnStatusMap[(h.status || '').toLowerCase()]).pop();
                                                if (returnEntry) { %>
                                                <div
                                                    style="display:flex;align-items:center;justify-content:center;gap:0.5rem;margin-top:1.5rem;">
                                                    <i class="fas fa-clock"
                                                        style="color:var(--accent);font-size:0.85rem;"></i>
                                                    <span style="font-size:0.85rem;color:#666;">
                                                        Last updated: <%= new
                                                            Date(returnEntry.changedAt).toLocaleDateString('en-IN',
                                                            {day:'numeric', month:'short', year:'numeric'}) %>
                                                    </span>
                                                </div>
                                                <% } %>
                                                    <% } else { %>
                                                        <!-- STEPPER -->
                                                        <div class="order-stepper">
                                                            <% steps.forEach((step, index)=> {
                                                                const stepNum = index + 1;
                                                                const isCompleted = stepNum < currentStepInfo; const
                                                                    isActive=stepNum===currentStepInfo; %>
                                                                    <div class="stepper-step">
                                                                        <div
                                                                            class="stepper-circle <%= isCompleted ? 'completed' : (isActive ? 'active' : '') %>">
                                                                            <% if (isCompleted) { %>
                                                                                <i class="fas fa-check"
                                                                                    style="font-size:0.75rem;"></i>
                                                                                <% } else { %>
                                                                                    <i class="fas <%= step.icon %>"
                                                                                        style="font-size:0.7rem;"></i>
                                                                                    <% } %>
                                                                        </div>
                                                                        <div
                                                                            class="stepper-label <%= isActive ? 'active' : (isCompleted ? 'completed' : '') %>">
                                                                            <%= step.label %>
                                                                        </div>
                                                                    </div>
                                                                    <% if (index < steps.length - 1) { %>
                                                                        <div
                                                                            class="stepper-connector <%= isCompleted ? 'completed' : '' %>">
                                                                        </div>
                                                                        <% } %>
                                                                            <% }) %>
                                                        </div>

                                                        <% if (order.estimatedDelivery && !isDelivered) { %>
                                                            <div
                                                                style="display:flex;align-items:center;justify-content:center;gap:0.5rem;margin-top:1.5rem;">
                                                                <i class="fas fa-truck"
                                                                    style="color:var(--accent);font-size:0.85rem;"></i>
                                                                <span style="font-size:0.85rem;color:#666;">
                                                                    Estimated delivery: <%= new
                                                                        Date(order.estimatedDelivery).toLocaleDateString('en-IN',
                                                                        {day:'numeric', month:'short', year:'numeric'})
                                                                        %>
                                                                </span>
                                                            </div>
                                                            <% } %>
                                                                <% } %>
                            </div>
                        </div>

                        <!-- BLOCK 2: ORDER ITEMS -->
                        <div class="order-detail-block" id="order-items">
                            <div class="order-detail-block-header">
                                <div style="display:flex;align-items:center;gap:14px;">
                                    <div class="order-icon-box" style="background:rgba(74,144,217,0.1);color:#4a90d9;">
                                        <i class="fas fa-shopping-bag"></i>
                                    </div>
                                    <h4 style="font-size:1rem;font-weight:600;margin:0;">Items Ordered</h4>
                                </div>
                                <span
                                    style="background:rgba(255,145,77,0.1);color:var(--accent);border-radius:20px;padding:3px 12px;font-size:0.8rem;font-weight:700;">
                                    <%= order.items.length %> Items
                                </span>
                            </div>

                            <div class="order-detail-block-body">
                                <% order.items.forEach((item, index)=> { 
                                    /* Determine display status: show "Delivered" instead of "Active" for delivered orders.
                                       Order may have moved from DELIVERED to Return Requested/Approved etc, so check return states too */
                                    const rawStatus = item.itemStatus || 'Active';
                                    const wasDelivered = isDelivered || ['returned', 'return requested', 'return approved', 'picked up', 'partially refunded'].includes(currentStatus);
                                    const displayStatus = (rawStatus === 'Active' && wasDelivered) ? 'Delivered' : rawStatus;
                                    const displayStatusClass = displayStatus.toLowerCase().replace(/\s+/g, '-');
                                    const isItemReturned = ['Returned', 'Cancelled'].includes(rawStatus);
                                    const isItemReturning = ['Return Requested', 'Return Approved', 'Picked Up'].includes(rawStatus);
                                %>
                                    <div class="detail-item-row"
                                        style="animation: fadeIn 0.4s ease backwards; animation-delay: <%= index * 0.08 %>s;<%= isItemReturned ? 'opacity:0.55;' : '' %>">
                                        <img src="<%= item.product.productImage ? item.product.productImage[0] : '/user/images/placeholder.jpg' %>"
                                            alt="<%= item.product.productName %>" class="detail-item-image"
                                            onclick="window.location.href='/user/product-details/<%= item.product._id %>'" />

                                        <div class="detail-item-info">
                                            <h4 onclick="window.location.href='/user/product-details/<%= item.product._id %>'"
                                                style="font-size:1rem;font-weight:700;color:var(--text-main);cursor:pointer;margin:0;transition:0.3s;"
                                                onmouseover="this.style.color='var(--accent)'"
                                                onmouseout="this.style.color='var(--text-main)'">
                                                <%= item.product.productName %>
                                            </h4>
                                            <span
                                                style="font-size:0.75rem;color:#999;text-transform:uppercase;letter-spacing:0.05em;margin-top:2px;display:block;">
                                                <%= item.product.category ? item.product.category.name : 'Sneakers' %>
                                            </span>
                                            <span
                                                class="order-status-badge status-<%= displayStatusClass %>"
                                                style="padding:2px 10px;font-size:0.72rem;margin-top:6px;display:inline-block;">
                                                <span class="status-dot"></span>
                                                <%= displayStatus %>
                                            </span>
                                            <% if (item.returnReason && (isItemReturning || rawStatus === 'Returned')) { %>
                                                <div style="display:flex;align-items:flex-start;gap:0.4rem;margin-top:6px;padding:5px 8px;background:rgba(243,156,18,0.08);border-left:3px solid #f39c12;border-radius:0 6px 6px 0;font-size:0.75rem;color:#856404;line-height:1.4;">
                                                    <i class="fas fa-comment-dots" style="margin-top:2px;flex-shrink:0;"></i>
                                                    <span><strong>Reason:</strong> <%= item.returnReason %></span>
                                                </div>
                                            <% } %>
                                        </div>

                                        <div class="detail-item-pricing">
                                            <div style="font-size:0.85rem;color:#888;margin-bottom:0.3rem;">Qty: <%= item.quantity %>
                                            </div>
                                            <div style="font-size:1.1rem;font-weight:800;color:<%= isItemReturned ? '#aaa' : 'var(--accent)' %>;<%= isItemReturned ? 'text-decoration:line-through;' : '' %>">₹<%= (item.product.salePrice || 0).toLocaleString('en-IN') %>
                                            </div>
                                            <% if (item.product.regularPrice > item.product.salePrice && !isItemReturned) { %>
                                                <span style="text-decoration:line-through;color:#bbb;font-size:0.85rem;display:block;">
                                                    ₹<%= item.product.regularPrice.toLocaleString('en-IN') %>
                                                </span>
                                            <% } %>

                                            <div style="display:flex;flex-direction:column;gap:5px;margin-top:0.5rem;align-items:flex-end;">
                                                <% if (canReview && rawStatus === 'Active') { %>
                                                    <button class="btn small-btn"
                                                        onclick="window.location.href='/user/product-details/<%= item.product._id %>#reviews'"
                                                        style="padding:4px 10px;font-size:0.75rem;background:transparent;border:1px solid var(--accent);color:var(--accent);border-radius:4px;cursor:pointer;">
                                                        <i class="fas fa-star" style="margin-right:4px;"></i>Review
                                                    </button>
                                                <% } %>

                                                <% if (canCancel && (!item.itemStatus || item.itemStatus === 'Active')) { %>
                                                    <button class="btn small-btn btn-danger"
                                                        onclick="cancelItemFromDetail('<%= order._id %>', '<%= item._id %>')"
                                                        style="padding:4px 10px;font-size:0.75rem;background:transparent;border:1px solid #dc3545;color:#dc3545;border-radius:4px;cursor:pointer;">
                                                        <i class="fas fa-times" style="margin-right:4px;"></i>Cancel
                                                    </button>
                                                <% } %>

                                                <% if (canReturn && (!item.itemStatus || item.itemStatus === 'Active')) { %>
                                                    <button class="btn small-btn btn-warning"
                                                        onclick="requestReturnItemFromDetail('<%= order._id %>', '<%= item._id %>')"
                                                        style="padding:4px 10px;font-size:0.75rem;background:transparent;border:1px solid #ffc107;color:#d39e00;border-radius:4px;cursor:pointer;">
                                                        <i class="fas fa-undo" style="margin-right:4px;"></i>Return
                                                    </button>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>

                            <div class="order-detail-block-footer">
                                <span style="font-size:0.85rem;color:#888;">
                                    <%= order.items.length %> item(s) total
                                </span>
                                <span style="font-size:1.2rem;font-weight:800;color:var(--text-main);">₹<%=
                                        order.totalAmount.toLocaleString('en-IN') %></span>
                            </div>
                        </div>

                        <!-- BLOCK 3: DELIVERY ADDRESS -->
                        <div class="order-detail-block">
                            <div class="order-detail-block-header">
                                <div style="display:flex;align-items:center;gap:14px;">
                                    <div class="order-icon-box" style="background:rgba(40,167,69,0.1);color:#28a745;">
                                        <i class="fas fa-map-marker-alt"></i>
                                    </div>
                                    <h4 style="font-size:1rem;font-weight:600;margin:0;">Delivery Address</h4>
                                </div>
                            </div>

                            <div class="order-detail-block-body"
                                style="display:flex;align-items:flex-start;gap:1.2rem;">
                                <div
                                    style="width:48px;height:48px;background:linear-gradient(135deg, rgba(255,145,77,0.12), rgba(255,145,77,0.06));border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                    <i class="fas fa-home" style="color:var(--accent);font-size:1.1rem;"></i>
                                </div>
                                <div style="flex:1;">
                                    <div
                                        style="font-size:1rem;font-weight:700;color:var(--text-main);margin-bottom:0.3rem;">
                                        <%= order.shippingAddress.fullName %>
                                    </div>
                                    <% const addrPhone=order.shippingAddress.phone || order.shippingAddress.mobile || ''
                                        ; %>
                                        <% if (addrPhone) { %>
                                            <div
                                                style="font-size:0.85rem;color:#666;display:flex;align-items:center;gap:0.4rem;margin-bottom:0.8rem;">
                                                <i class="fas fa-phone"></i>
                                                <%= addrPhone %>
                                            </div>
                                            <% } %>
                                                <div style="font-size:0.9rem;color:#555;line-height:1.7;">
                                                    <%= order.shippingAddress.street || order.shippingAddress.houseName
                                                        || '' %><br>
                                                        <span
                                                            style="font-weight:500;margin-top:0.2rem;display:inline-block;">
                                                            <%= order.shippingAddress.city %>, <%=
                                                                    order.shippingAddress.state %> —
                                                                    <%= order.shippingAddress.zip ||
                                                                        order.shippingAddress.pincode || '' %>
                                                        </span>
                                                </div>
                                </div>
                            </div>
                        </div>

                        <!-- BLOCK 4: ORDER & PAYMENT SUMMARY -->
                        <div class="order-detail-block">
                            <div class="order-detail-block-header">
                                <div style="display:flex;align-items:center;gap:14px;">
                                    <div class="order-icon-box" style="background:rgba(102,126,234,0.1);color:#667eea;">
                                        <i class="fas fa-receipt"></i>
                                    </div>
                                    <h4 style="font-size:1rem;font-weight:600;margin:0;">Order Summary</h4>
                                </div>
                            </div>

                            <div class="order-detail-block-body" style="padding:0;">

                                <!-- Per-item price breakdown -->
                                <div class="summary-items-list">
                                    <% order.items.forEach((item, index) => {
                                        const isItemReturned = ['Returned', 'Cancelled'].includes(item.itemStatus || 'Active');
                                        const itemTotal = (item.product.salePrice || item.priceAtPurchase || 0) * item.quantity;
                                    %>
                                        <div class="summary-item-row <%= isItemReturned ? 'item-struck' : '' %>">
                                            <div class="summary-item-left">
                                                <span class="summary-item-name"><%= item.product.productName %></span>
                                                <span class="summary-item-meta">
                                                    <% if (item.variantSize) { %>Size: <%= item.variantSize %> · <% } %>
                                                    Qty: <%= item.quantity %>
                                                    <% if (isItemReturned) { %> · <span style="color:#dc3545;font-weight:600;"><%= item.itemStatus || 'Active' %></span><% } %>
                                                </span>
                                            </div>
                                            <div class="summary-item-price <%= isItemReturned ? 'struck' : '' %>">
                                                ₹<%= itemTotal.toLocaleString('en-IN') %>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>

                                <!-- Price breakdown -->
                                <div class="summary-breakdown">
                                    <div class="summary-row">
                                        <span class="summary-label">Subtotal</span>
                                        <span class="summary-value">₹<%= (order.subtotal || order.totalAmount).toLocaleString('en-IN') %></span>
                                    </div>

                                    <% if (order.discountAmount && order.discountAmount > 0) { %>
                                        <div class="summary-row summary-discount">
                                            <span class="summary-label">
                                                <i class="fas fa-tag" style="margin-right:6px;"></i>Coupon Discount
                                                <% if (order.couponCode) { %>
                                                    <span class="coupon-badge"><%= order.couponCode %></span>
                                                <% } %>
                                            </span>
                                            <span class="summary-value" style="color:#28a745;">−₹<%= order.discountAmount.toLocaleString('en-IN') %></span>
                                        </div>
                                    <% } %>

                                    <div class="summary-row">
                                        <span class="summary-label">
                                            <i class="fas fa-shipping-fast" style="margin-right:6px;"></i>Shipping
                                        </span>
                                        <span class="summary-value">
                                            <% if (order.shippingCharge && order.shippingCharge > 0) { %>
                                                ₹<%= order.shippingCharge.toLocaleString('en-IN') %>
                                            <% } else { %>
                                                <span style="color:#28a745;font-weight:600;">FREE</span>
                                            <% } %>
                                        </span>
                                    </div>

                                    <!-- Grand Total -->
                                    <div class="summary-row summary-total">
                                        <span class="summary-label">Total Amount</span>
                                        <span class="summary-value">₹<%= order.totalAmount.toLocaleString('en-IN') %></span>
                                    </div>
                                </div>

                                <!-- Payment method & status -->
                                <div class="summary-payment-strip">
                                    <div class="payment-method-info">
                                        <% if (order.paymentMethod === 'COD') { %>
                                            <div class="payment-icon-circle" style="background:rgba(40,167,69,0.1);color:#28a745;">
                                                <i class="fas fa-money-bill-wave"></i>
                                            </div>
                                            <div>
                                                <span class="payment-method-name">Cash on Delivery</span>
                                                <span class="payment-method-sub">Pay when you receive</span>
                                            </div>
                                        <% } else if (order.paymentMethod === 'Razorpay') { %>
                                            <div class="payment-icon-circle" style="background:rgba(102,126,234,0.1);color:#667eea;">
                                                <i class="fas fa-credit-card"></i>
                                            </div>
                                            <div>
                                                <span class="payment-method-name">Razorpay</span>
                                                <span class="payment-method-sub">Online Payment</span>
                                            </div>
                                        <% } else if (order.paymentMethod === 'Wallet') { %>
                                            <div class="payment-icon-circle" style="background:rgba(255,145,77,0.1);color:var(--accent);">
                                                <i class="fas fa-wallet"></i>
                                            </div>
                                            <div>
                                                <span class="payment-method-name">Wallet</span>
                                                <span class="payment-method-sub">Paid from wallet balance</span>
                                            </div>
                                        <% } else { %>
                                            <div class="payment-icon-circle" style="background:rgba(102,126,234,0.1);color:#667eea;">
                                                <i class="fas fa-credit-card"></i>
                                            </div>
                                            <div>
                                                <span class="payment-method-name"><%= order.paymentMethod %></span>
                                                <span class="payment-method-sub">Online Payment</span>
                                            </div>
                                        <% } %>
                                    </div>
                                    <% const paidColor = order.paymentStatus === 'Paid' ? '#28a745' :
                                        (order.paymentStatus === 'Refunded' ? '#4a90d9' :
                                        (order.paymentStatus === 'Failed' ? '#dc3545' : 'var(--accent)')); %>
                                    <div class="payment-status-chip" style="background:<%= paidColor %>15;color:<%= paidColor %>;border:1px solid <%= paidColor %>30;">
                                        <span style="width:7px;height:7px;border-radius:50%;background:<%= paidColor %>;display:inline-block;"></span>
                                        <%= order.paymentStatus %>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- BLOCK 5: ACTION BUTTONS -->
                        <div class="action-buttons-row">
                                    <% if (order.paymentStatus==='Failed' || (order.paymentStatus==='Pending' &&
                                        order.paymentMethod==='Razorpay' )) { %>
                                        <button class="action-btn-detail action-btn-retry" id="retryPaymentBtn"
                                            data-order-id="<%= order._id %>">
                                            <i class="fas fa-redo"></i> Retry Payment
                                        </button>
                                        <% } %>

                                            <% if (canReview) { %>
                                                <button class="action-btn-detail action-btn-review"
                                                    onclick="document.getElementById('order-items').scrollIntoView({behavior: 'smooth'})"
                                                    style="background:rgba(255, 215, 0, 0.1);color:#d4af37;border:1px solid rgba(255, 215, 0, 0.3);">
                                                    <i class="fas fa-star"></i> Review Products
                                                </button>
                                                <% } %>

                                                    <% if (isDelivered) { %>
                                                        <button class="action-btn-detail action-btn-invoice"
                                                            onclick="downloadInvoiceFromDetail('<%= order._id %>')">
                                                            <i class="fas fa-file-invoice"></i> Download Invoice
                                                        </button>
                                                        <% } %>

                                                            <button class="action-btn-detail action-btn-support"
                                                                onclick="openSupportModal()">
                                                                <i class="fas fa-headset"></i> Contact Support
                                                            </button>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SUPPORT MODAL -->
    <div id="supportModal" class="custom-modal" style="display:none;">
        <div class="modal-overlay" onclick="closeSupportModal()"></div>
        <div class="modal-container" style="max-width:480px;padding:0;">
            <div
                style="background:linear-gradient(135deg, #4a90d9 0%, #357abd 100%);padding:28px 30px 22px;border-radius:24px 24px 0 0;">
                <div
                    style="width:48px;height:48px;background:rgba(255,255,255,0.2);border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">
                    <i class="fas fa-headset" style="font-size:1.5rem;color:white;"></i>
                </div>
                <h3 style="color:white;margin:0;font-size:1.3rem;">Contact Support</h3>
                <p style="color:rgba(255,255,255,0.8);margin:5px 0 0;font-size:0.9rem;">We're here to help you</p>
            </div>

            <div style="padding:28px 30px;">
                <div class="support-contact-card" style="margin-bottom:1rem;"
                    onclick="window.location.href='mailto:support@sneakerstore.in'">
                    <div
                        style="width:48px;height:48px;border-radius:50%;background:rgba(255,145,77,0.1);display:flex;align-items:center;justify-content:center;color:var(--accent);">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <div>
                        <div style="font-weight:700;color:var(--text-main);font-size:0.95rem;">Email Support</div>
                        <div style="font-size:0.85rem;color:#666;margin-top:2px;">support@sneakerstore.in</div>
                    </div>
                </div>

                <div class="support-contact-card" onclick="window.location.href='tel:+919876543210'">
                    <div
                        style="width:48px;height:48px;border-radius:50%;background:rgba(74,144,217,0.1);display:flex;align-items:center;justify-content:center;color:#4a90d9;">
                        <i class="fas fa-phone"></i>
                    </div>
                    <div>
                        <div style="font-weight:700;color:var(--text-main);font-size:0.95rem;">Call Us</div>
                        <div style="font-size:0.85rem;color:#666;margin-top:2px;">+91 98765 43210</div>
                        <div style="font-size:0.78rem;color:#aaa;">Mon–Sat, 10am–7pm</div>
                    </div>
                </div>

                <div
                    style="text-align:center;margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid rgba(0,0,0,0.06);">
                    <p style="font-size:0.82rem;color:#aaa;margin:0;">Reference: Order #<%= shortId %>
                    </p>
                </div>

                <button class="btn outline" onclick="closeSupportModal()"
                    style="width:100%;margin-top:1.5rem;padding:0.8rem;">Close</button>
            </div>
        </div>
    </div>

    <!-- CANCEL CONFIRMATION MODAL -->
    <div id="cancelConfirmModal" class="custom-modal" style="display:none;z-index:1100;">
        <div class="modal-overlay" onclick="closeCancelModal()"></div>
        <div class="modal-container" style="max-width:420px;text-align:center;padding:30px 25px;">
            <div
                style="width:60px;height:60px;background:rgba(220,53,69,0.1);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;">
                <i class="fas fa-exclamation-triangle" style="font-size:1.8rem;color:#dc3545;"></i>
            </div>

            <h3 style="margin-bottom:0.5rem;font-size:1.4rem;color:var(--text-main);">Cancel Order?</h3>
            <p style="color:#666;font-size:0.95rem;line-height:1.6;margin-bottom:1.5rem;">
                Are you sure you want to cancel this order? This action <strong>cannot be undone</strong>.
            </p>

            <div
                style="background:#f8f9fa;border-radius:12px;padding:1rem;margin-bottom:1.8rem;text-align:left;border:1px solid rgba(0,0,0,0.04);">
                <div style="display:flex;justify-content:space-between;margin-bottom:0.5rem;">
                    <span style="color:#888;font-size:0.85rem;">Order ID</span>
                    <span style="font-weight:600;font-family:silver;color:var(--text-main);">#<%= shortId %></span>
                </div>
                <div style="display:flex;justify-content:space-between;">
                    <span style="color:#888;font-size:0.85rem;">Refund Amount</span>
                    <span style="font-weight:700;color:var(--accent);">₹<%= order.totalAmount.toLocaleString('en-IN') %>
                    </span>
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <button class="btn outline" onclick="closeCancelModal()" style="padding:0.8rem;">No, Keep It</button>
                <button id="confirmCancelBtn" class="btn primary" onclick="confirmCancelAction()"
                    style="padding:0.8rem;background:#dc3545;border-color:#dc3545;box-shadow:0 4px 15px rgba(220,53,69,0.25);">
                    Yes, Cancel
                </button>
            </div>
        </div>
    </div>

    <!-- RETURN CONFIRMATION MODAL -->
    <div id="returnConfirmModal" class="custom-modal" style="display:none;z-index:1100;">
        <div class="modal-overlay" onclick="closeReturnModal()"></div>
        <div class="modal-container" style="max-width:420px;text-align:center;padding:30px 25px;">
            <div
                style="width:60px;height:60px;background:rgba(255,145,77,0.1);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;">
                <i class="fas fa-undo" style="font-size:1.8rem;color:var(--accent);"></i>
            </div>

            <h3 style="margin-bottom:0.5rem;font-size:1.4rem;color:var(--text-main);">Return Order?</h3>
            <p style="color:#666;font-size:0.95rem;line-height:1.6;margin-bottom:1.5rem;">
                Are you sure you want to request a return for this order? Once approved, a pickup will be scheduled.
            </p>

            <div
                style="background:#f8f9fa;border-radius:12px;padding:1rem;margin-bottom:1.2rem;text-align:left;border:1px solid rgba(0,0,0,0.04);">
                <div style="display:flex;justify-content:space-between;margin-bottom:0.5rem;">
                    <span style="color:#888;font-size:0.85rem;">Order ID</span>
                    <span style="font-weight:600;font-family:silver;color:var(--text-main);">#<%= shortId %></span>
                </div>
                <div style="display:flex;justify-content:space-between;">
                    <span style="color:#888;font-size:0.85rem;">Refund Amount</span>
                    <span style="font-weight:700;color:var(--accent);">₹<%= order.totalAmount.toLocaleString('en-IN') %>
                    </span>
                </div>
            </div>

            <div style="text-align: left; margin-bottom: 1.5rem;">
                <label
                    style="display:block; font-size: 0.9rem; font-weight: 600; color: var(--text-main); margin-bottom: 10px; text-align: left;">Reason
                    for Return <span style="color:#dc3545">*</span></label>

                <div style="display:flex; flex-direction: column; align-items: flex-start; justify-content: flex-start; gap: 10px; margin-bottom: 12px; padding-left: 4px; width: 100%;"
                    id="returnReasonContainer">
                    <label
                        style="display:grid; grid-template-columns: 20px 1fr; gap:10px; align-items:flex-start; cursor:pointer; color:#444; line-height: 1.4; width: 100%; text-align: left; margin:0;">
                        <span style="display:flex; justify-content:center; align-items:center; height:20px;">
                            <input type="radio" name="returnReason" value="Received wrong item"
                                style="accent-color:var(--accent); margin:0;">
                        </span>
                        <span>Received wrong item</span>
                    </label>
                    <label
                        style="display:grid; grid-template-columns: 20px 1fr; gap:10px; align-items:flex-start; cursor:pointer; color:#444; line-height: 1.4; width: 100%; text-align: left; margin:0;">
                        <span style="display:flex; justify-content:center; align-items:center; height:20px;">
                            <input type="radio" name="returnReason" value="Item damaged or defective"
                                style="accent-color:var(--accent); margin:0;">
                        </span>
                        <span>Item damaged or defective</span>
                    </label>
                    <label
                        style="display:grid; grid-template-columns: 20px 1fr; gap:10px; align-items:flex-start; cursor:pointer; color:#444; line-height: 1.4; width: 100%; text-align: left; margin:0;">
                        <span style="display:flex; justify-content:center; align-items:center; height:20px;">
                            <input type="radio" name="returnReason" value="Size doesn't fit"
                                style="accent-color:var(--accent); margin:0;">
                        </span>
                        <span>Size doesn't fit</span>
                    </label>
                    <label
                        style="display:grid; grid-template-columns: 20px 1fr; gap:10px; align-items:flex-start; cursor:pointer; color:#444; line-height: 1.4; width: 100%; text-align: left; margin:0;">
                        <span style="display:flex; justify-content:center; align-items:center; height:20px;">
                            <input type="radio" name="returnReason" value="Other"
                                style="accent-color:var(--accent); margin:0;">
                        </span>
                        <span>Other</span>
                    </label>
                </div>

                <textarea id="returnReasonText" rows="3" placeholder="Please provide more details..."
                    style="width: 100%; border: 1px solid rgba(0,0,0,0.1); border-radius: 8px; padding: 10px; font-family: inherit; font-size: 0.85rem; resize: vertical; display:none;"></textarea>
                <div id="returnReasonError" style="color: #dc3545; font-size: 0.8rem; margin-top: 5px; display: none;">
                    Please select or enter a reason.</div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <button class="btn outline" onclick="closeReturnModal()" style="padding:0.8rem;">No, Keep It</button>
                <button id="confirmReturnBtn" class="btn primary" onclick="confirmReturnAction()"
                    style="padding:0.8rem;background:var(--accent);border-color:var(--accent);box-shadow:0 4px 15px rgba(255,145,77,0.25);">
                    Yes, Return
                </button>
            </div>
        </div>
    </div>

    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="/user/js/order-detail.js" defer></script>
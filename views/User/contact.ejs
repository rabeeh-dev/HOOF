<link rel="stylesheet" href="/user/css/contact.css" />

<section class="section hero-contact reveal">
    <div class="container hero-contact-inner">
        <p class="band-label">REACH OUT</p>
        <h1 class="hero-title">GET IN TOUCH</h1>
        <p class="hero-subtitle">We'd love to hear from you — reach out anytime</p>
    </div>
</section>

<section class="section contact-layout-section reveal">
    <div class="container">
        <div class="contact-layout-grid">

            <!-- LEFT — Info Cards -->
            <div class="contact-info-col">
                <div class="contact-info-card">
                    <div class="contact-icon-wrap"><i class="fas fa-map-marker-alt"></i></div>
                    <div class="contact-info-content">
                        <h4>Visit Us</h4>
                        <p>HOOF Sneaker House, Malappuram, Kerala 676505</p>
                    </div>
                </div>
                <div class="contact-info-card">
                    <div class="contact-icon-wrap"><i class="fas fa-envelope"></i></div>
                    <div class="contact-info-content">
                        <h4>Email Us</h4>
                        <p>support@hoofsnkrs.com</p>
                    </div>
                </div>
                <div class="contact-info-card">
                    <div class="contact-icon-wrap"><i class="fas fa-phone"></i></div>
                    <div class="contact-info-content">
                        <h4>Call Us</h4>
                        <p>+91 98765 43210</p>
                    </div>
                </div>
                <div class="contact-info-card">
                    <div class="contact-icon-wrap"><i class="fas fa-clock"></i></div>
                    <div class="contact-info-content">
                        <h4>Business Hours</h4>
                        <p>Mon – Sat: 10 AM – 8 PM</p>
                    </div>
                </div>
            </div>

            <!-- RIGHT — Contact Form -->
            <div class="contact-form-card">
                <div class="contact-form-header">
                    <h2>Send Us a Message</h2>
                    <p>Fill out the form below and we'll get back to you shortly.</p>
                </div>
                <form id="contactForm">
                    <div class="contact-form-fields">
                        <div class="contact-form-row">
                            <div class="contact-form-group">
                                <label for="contactName">Full Name</label>
                                <input type="text" id="contactName" name="name" placeholder="Your name" required />
                            </div>
                            <div class="contact-form-group">
                                <label for="contactEmail">Email</label>
                                <input type="email" id="contactEmail" name="email" placeholder="you@example.com"
                                    required />
                            </div>
                        </div>
                        <div class="contact-form-group">
                            <label for="contactSubject">Subject</label>
                            <input type="text" id="contactSubject" name="subject" placeholder="How can we help?"
                                required />
                        </div>
                        <div class="contact-form-group">
                            <label for="contactMessage">Message</label>
                            <textarea id="contactMessage" name="message" rows="6" placeholder="Tell us more..."
                                required></textarea>
                        </div>
                        <button type="submit" class="contact-submit-btn" id="contactSubmitBtn">
                            Send Message <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</section>

<section class="section contact-location-section reveal">
    <div class="container">
        <div class="section-header">
            <p class="band-label">FIND US</p>
            <h2>OUR LOCATION</h2>
            <p class="section-subtitle">Visit our flagship store and experience sneakers in person</p>
        </div>
        <div class="contact-map-card">
            <i class="fas fa-map-marker-alt contact-map-pin"></i>
            <h3 class="contact-map-store">HOOF Sneaker House</h3>
            <p class="contact-map-address">Malappuram, Kerala 676505, India</p>
            <a href="https://maps.google.com/?q=Malappuram+Kerala" target="_blank" rel="noopener"
                class="contact-map-btn">
                Open in Maps <i class="fas fa-external-link-alt"></i>
            </a>
        </div>
    </div>
</section>

<script src="/user/js/contact.js" defer></script>
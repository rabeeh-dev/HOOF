<link rel="stylesheet" href="/user/css/shop.css" />
<link rel="stylesheet" href="/user/css/checkout.css" />

<section class="page-header">
    <div class="container">
        <h1 class="page-title">CHECKOUT</h1>
        <p class="page-subtitle">You're one step away from your perfect pair</p>
    </div>
</section>

<!-- Progress Bar -->
<section class="checkout-progress">
    <div class="container">
        <div class="progress-steps">
            <div class="step-item active" data-step="1">
                <div class="step-circle">1</div>
                <span class="step-label">Address</span>
            </div>
            <div class="step-connector"></div>
            <div class="step-item" data-step="2">
                <div class="step-circle">2</div>
                <span class="step-label">Payment</span>
            </div>
            <div class="step-connector"></div>
            <div class="step-item" data-step="3">
                <div class="step-circle">3</div>
                <span class="step-label">Confirm</span>
            </div>
        </div>
    </div>
</section>

<section class="checkout-section">
    <div class="container">
        <div class="checkout-layout">
            <!-- LEFT COLUMN: Multi-Step Form -->
            <div class="checkout-form-col">
                <!-- Step 1: Delivery Address -->
                <div id="stepAddress" class="checkout-step">
                    <div class="checkout-card">
                        <div class="checkout-card-header">
                            <h2>Delivery Address</h2>
                            <p>Select a saved address or add a new one</p>
                        </div>

                        <div class="checkout-card-body">
                            <!-- Saved Addresses -->
                            <% if (addresses && addresses.length> 0) { %>
                                <div class="saved-addresses" id="savedAddresses">
                                    <% addresses.forEach((address)=> { %>
                                        <div class="address-card" data-address-id="<%= address._id %>"
                                            onclick="selectAddress('<%= address._id %>')">
                                            <div class="address-radio">
                                                <div class="radio-circle"></div>
                                            </div>
                                            <div class="address-details">
                                                <div class="address-header">
                                                    <span class="address-name">
                                                        <%= address.fullName %>
                                                    </span>
                                                    <% if (address.isDefault) { %>
                                                        <span class="default-badge">DEFAULT</span>
                                                        <% } %>
                                                </div>
                                                <div class="address-phone">
                                                    <%= address.mobile %>
                                                </div>
                                                <div class="address-lines">
                                                    <%= address.houseName %><br>
                                                        <%= address.city %>, <%= address.state %> - <%= address.pincode
                                                                    %>
                                                </div>
                                                <a class="address-edit" href="/user/address"
                                                    onclick="event.stopPropagation();">Manage</a>
                                            </div>
                                        </div>
                                        <% }) %>
                                </div>
                                <% } else { %>
                                    <div class="no-addresses" id="noAddressesState">
                                        <p>No saved addresses found. Please add one to continue checkout.</p>
                                    </div>
                                    <% } %>

                                        <div class="address-actions">
                                            <button type="button" class="add-address-toggle"
                                                onclick="toggleCheckoutAddressForm()">
                                                <i class="fas fa-plus"></i>
                                                Add New Address
                                            </button>
                                            <a class="manage-address-btn" href="/user/address">
                                                <i class="fas fa-address-book"></i>
                                                Manage Addresses
                                            </a>
                                        </div>

                                        <div id="checkoutAddressFormWrap" class="new-address-form"
                                            style="display: none;">
                                            <div class="form-fields">
                                                <form id="checkoutAddAddressForm">
                                                    <div class="form-row">
                                                        <div class="form-group">
                                                            <label>Full Name <span class="req">*</span></label>
                                                            <input type="text" name="fullName" id="coFullName"
                                                                placeholder="Enter full name" required>
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Mobile Number <span class="req">*</span></label>
                                                            <input type="tel" name="mobile" id="coMobile"
                                                                placeholder="10-digit number" required>
                                                            <small class="validation-message"
                                                                id="coMobileError"></small>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>House Name / Flat No <span class="req">*</span></label>
                                                        <input type="text" name="houseName" id="coHouseName"
                                                            placeholder="e.g. Flat 12B, Sunrise Apartments" required>
                                                    </div>
                                                    <div class="form-row">
                                                        <div class="form-group">
                                                            <label>City <span class="req">*</span></label>
                                                            <input type="text" name="city" id="coCity"
                                                                placeholder="Enter city" required>
                                                        </div>
                                                        <div class="form-group">
                                                            <label>State <span class="req">*</span></label>
                                                            <input type="text" name="state" id="coState"
                                                                placeholder="Enter state" required>
                                                        </div>
                                                    </div>
                                                    <div class="form-row">
                                                        <div class="form-group">
                                                            <label>Pincode <span class="req">*</span></label>
                                                            <input type="text" name="pincode" id="coPincode"
                                                                placeholder="6-digit pincode" required>
                                                            <small class="validation-message"
                                                                id="coPincodeError"></small>
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Address Type</label>
                                                            <select name="addressType" id="coAddressType">
                                                                <option value="Home">🏠 Home</option>
                                                                <option value="Work">💼 Work</option>
                                                                <option value="Other">📍 Other</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <label class="form-checkbox">
                                                        <input type="checkbox" name="isDefault" id="coIsDefault">
                                                        Set as default address
                                                    </label>
                                                    <button type="submit" class="btn primary" id="coSaveAddressBtn">
                                                        <i class="fas fa-plus"></i>
                                                        Save Address
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                        </div>

                        <div class="checkout-card-footer">
                            <button class="btn-continue" onclick="validateAndContinue(1)">Continue to Payment</button>
                        </div>
                    </div>
                </div>

                <!-- Step 2: Payment Method -->
                <div id="stepPayment" class="checkout-step" style="display: none;">
                    <div class="checkout-card">
                        <div class="checkout-card-header">
                            <div class="header-row">
                                <h2>Payment Method</h2>
                                <button class="back-link" onclick="goToStep(1)">← Back to Address</button>
                            </div>
                        </div>

                        <div class="checkout-card-body">
                            <!-- Payment Options -->
                            <div class="payment-options">
                                <!-- UPI Option -->
                                <div class="payment-card" data-payment="upi" onclick="selectPayment('upi')">
                                    <div class="payment-radio">
                                        <div class="radio-circle"></div>
                                    </div>
                                    <div class="payment-details">
                                        <i class="fas fa-mobile-alt"></i>
                                        <div>
                                            <div class="payment-label">UPI Payment</div>
                                            <div class="payment-sublabel">Pay via GPay, PhonePe, Paytm</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Wallet Option -->
                                <% const checkoutTotal=totalAmount>= 999 ? totalAmount : totalAmount + 99; %>
                                    <% const walletSufficient=typeof walletBalance !=='undefined' && walletBalance>=
                                        checkoutTotal; %>
                                        <div class="payment-card <%= walletSufficient ? '' : 'disabled' %>"
                                            data-payment="wallet" onclick="selectPayment('wallet')"
                                            id="walletPaymentCard">
                                            <div class="payment-radio">
                                                <div class="radio-circle"></div>
                                            </div>
                                            <div class="payment-details">
                                                <i class="fas fa-wallet"></i>
                                                <div>
                                                    <div class="payment-label">Wallet</div>
                                                    <div class="payment-sublabel">
                                                        Balance: ₹<%= typeof walletBalance !=='undefined' ?
                                                            walletBalance.toLocaleString('en-IN') : '0' %>
                                                            <% if (!walletSufficient) { %>
                                                                <span style="color:#dc3545;"> (Insufficient
                                                                    Balance)</span>
                                                                <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Card Option -->
                                        <div class="payment-card disabled" data-payment="card"
                                            onclick="selectPayment('card')">
                                            <div class="payment-radio">
                                                <div class="radio-circle"></div>
                                            </div>
                                            <div class="payment-details">
                                                <i class="fas fa-credit-card"></i>
                                                <div>
                                                    <div class="payment-label">Credit / Debit Card</div>
                                                    <div class="payment-sublabel">Coming Soon (Inactive)</div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- COD Option -->
                                        <div class="payment-card" data-payment="cod" onclick="selectPayment('cod')">
                                            <div class="payment-radio">
                                                <div class="radio-circle"></div>
                                            </div>
                                            <div class="payment-details">
                                                <i class="fas fa-money-bill-wave"></i>
                                                <div>
                                                    <div class="payment-label">Cash on Delivery</div>
                                                    <div class="payment-sublabel">Pay when your order arrives</div>
                                                </div>
                                            </div>
                                        </div>
                            </div>
                        </div>

                        <div class="checkout-card-footer">
                            <button class="btn-continue" onclick="validateAndContinue(2)">Proceed to Review</button>
                        </div>
                    </div>
                </div>

                <!-- Step 3: Order Review -->
                <div id="stepConfirm" class="checkout-step" style="display: none;">
                    <div class="checkout-card">
                        <div class="checkout-card-header">
                            <div class="header-row">
                                <h2>Review Your Order</h2>
                                <button class="back-link" onclick="goToStep(2)">← Back to Payment</button>
                            </div>
                        </div>

                        <div class="checkout-card-body">
                            <!-- Delivery Summary -->
                            <div class="review-block">
                                <div class="review-header">
                                    <h3>Delivery To</h3>
                                    <button class="edit-link" onclick="goToStep(1)">Edit</button>
                                </div>
                                <div class="review-content" id="deliverySummary">
                                    <!-- Populated by JS -->
                                </div>
                            </div>

                            <!-- Payment Summary -->
                            <div class="review-block">
                                <div class="review-header">
                                    <h3>Payment Method</h3>
                                    <button class="edit-link" onclick="goToStep(2)">Edit</button>
                                </div>
                                <div class="review-content" id="paymentSummary">
                                    <!-- Populated by JS -->
                                </div>
                            </div>

                            <!-- Order Items -->
                            <div class="review-block">
                                <h3>Order Items</h3>
                                <div class="order-items-list">
                                    <% if (typeof cartItems !=='undefined' && cartItems.length> 0) { %>
                                        <% cartItems.forEach((item)=> { %>
                                            <div class="order-item">
                                                <img src="<%= item.productId.productImage[0] %>"
                                                    alt="<%= item.productId.productName %>">
                                                <div class="order-item-name">
                                                    <%= item.productId.productName %>
                                                        <% if (item.size) { %>
                                                            <small
                                                                style="display:block;color:#888;font-size:0.8rem;font-weight:400;margin-top:2px;"><i
                                                                    class="fas fa-ruler" style="font-size:0.7rem;"></i>
                                                                Size: <%= item.size %></small>
                                                            <% } %>
                                                </div>
                                                <span class="order-item-qty">Qty: <%= item.quantity %></span>
                                                <span class="order-item-price">₹<%= item.totalPrice %></span>
                                            </div>
                                            <% }) %>
                                                <% } %>
                                </div>
                            </div>
                        </div>

                        <div class="checkout-card-footer">
                            <button class="btn-place-order" onclick="placeOrder()">Place Order</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: Order Summary -->
            <div class="order-summary-col">
                <div class="order-summary-card">
                    <h2>Order Summary</h2>
                    <div class="summary-items">
                        <% if (typeof cartItems !=='undefined' && cartItems.length> 0) { %>
                            <% const maxItems=4; %>
                                <% cartItems.slice(0, maxItems).forEach((item)=> { %>
                                    <div class="summary-item">
                                        <img src="<%= item.productId.productImage[0] %>"
                                            alt="<%= item.productId.productName %>">
                                        <div class="summary-item-name">
                                            <%= item.productId.productName %>
                                                <% if (item.size) { %>
                                                    <small
                                                        style="display:block;color:#999;font-size:0.75rem;margin-top:2px;">Size:
                                                        <%= item.size %>
                                                    </small>
                                                    <% } %>
                                        </div>
                                        <span class="summary-item-qty">
                                            <%= item.quantity %>
                                        </span>
                                        <span class="summary-item-price">₹<%= item.totalPrice %></span>
                                    </div>
                                    <% }) %>
                                        <% if (cartItems.length> maxItems) { %>
                                            <div class="more-items">
                                                <a href="#" onclick="return false;">and <%= cartItems.length - maxItems
                                                        %> more items</a>
                                            </div>
                                            <% } %>
                                                <% } %>
                    </div>

                    <!-- Coupon Section -->
                    <div class="coupon-section">
                        <div class="coupon-input-group">
                            <input type="text" id="couponCodeInput" placeholder="Enter coupon code"
                                class="coupon-input">
                            <button class="btn-apply-coupon" onclick="applyCoupon()">Apply</button>
                        </div>
                        <button class="available-coupons-btn" onclick="openCouponModal()">
                            <i class="fas fa-tag"></i> View Available Coupons
                        </button>
                        <div id="appliedCouponInfo" class="applied-coupon-info" style="display: none;">
                            <span class="coupon-tag">
                                <i class="fas fa-check-circle"></i>
                                <span id="appliedCouponCodeText"></span>
                                <button onclick="removeCoupon()" class="remove-coupon-btn">&times;</button>
                            </span>
                        </div>
                    </div>

                    <div class="summary-breakdown">
                        <div class="summary-row">
                            <span>Subtotal</span>
                            <span>₹<%= totalAmount %></span>
                        </div>
                        <div class="summary-row">
                            <span>Shipping</span>
                            <span class="<%= totalAmount >= 999 ? 'shipping-free' : '' %>">
                                <%= totalAmount>= 999 ? 'FREE' : '₹99' %>
                            </span>
                        </div>
                        <div id="summaryDiscountRow" class="summary-row summary-discount"
                            style="display: none; color: #2ecc71; font-weight: 600;">
                            <span>Discount</span>
                            <span id="summaryDiscountAmount">-₹0</span>
                        </div>
                        <div class="summary-divider"></div>
                        <div class="summary-row summary-total">
                            <span>Total</span>
                            <span>₹<%= totalAmount>= 999 ? totalAmount : totalAmount + 99 %></span>
                        </div>
                    </div>
                    <div class="delivery-info">
                        <i class="fas fa-truck"></i>
                        <span>Estimated delivery: 3-5 business days</span>
                    </div>
                    <div class="security-badges">
                        <div class="badge-item">
                            <i class="fas fa-lock"></i>
                            <span>Secure</span>
                        </div>
                        <div class="badge-item">
                            <i class="fas fa-shield-alt"></i>
                            <span>Authentic</span>
                        </div>
                        <div class="badge-item">
                            <i class="fas fa-check-circle"></i>
                            <span>Guaranteed</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div id="couponModal" class="coupon-modal">
    <div class="modal-content glass">
        <div class="modal-header">
            <h3>Available Coupons</h3>
            <button class="close-btn" onclick="closeCouponModal()">&times;</button>
        </div>
        <div class="modal-body" id="availableCouponsList">
            <!-- Coupons will be loaded here via JS -->
            <div class="loading-coupons">
                <i class="fas fa-spinner fa-spin"></i> Loading coupons...
            </div>
        </div>
    </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script src="/user/js/checkout.js" defer></script>
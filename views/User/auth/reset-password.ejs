<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password | HOOF</title>
  <link rel="stylesheet" href="/user/css/reset-password.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="icon" type="image/x-icon" href="./images/favicon.ico">
</head>
<body>
  <!-- NAVBAR -->
  <header class="topbar">
    <div class="container nav-inner">
      <a href="javascript:history.back()" class="nav-back" aria-label="Go back">
        <i class="fa-solid fa-arrow-left"></i>
      </a>
      <div class="logo">HOOF</div>
      <nav class="nav">
        <ul class="nav-links">
          <li><a href="home.html#home">Home</a></li>
          <li><a href="index.html#about">About</a></li>
          <li><a href="home.html#products">Shop</a></li>
          <li><a href="index.html#contact">Contact</a></li>
        </ul>
        <div class="nav-actions">
          <a href="#" class="nav-icon" title="Wishlist"><i class="far fa-heart"></i><span class="nav-badge">0</span></a>
          <a href="#" class="nav-icon cart-icon" title="Cart"><i class="fas fa-shopping-bag"></i><span class="nav-badge cart-count">0</span></a>
        </div>
        <button class="nav-toggle" id="nav-toggle">
          <span></span><span></span><span></span>
        </button>
      </nav>
    </div>
  </header>

  <!-- RESET PASSWORD -->
  <section class="section signup-hero reveal">
    <div class="container">
      <div class="signup-container">
        <div class="signup-card">
          <div class="reset-header">
            <h1 class="reset-title">Reset Password</h1>
            <p class="reset-subtitle">Create a new password for your HOOF account</p>
          </div>

          <form class="signup-form" id="resetForm" method="POST"
            action="/user/reset-password/<%= token %>">
            <div class="form-group">
              <label for="newPassword">New Password</label>
              <div class="input-wrapper">
                <i class="fas fa-lock input-icon"></i>
                <input type="password" id="newPassword" name="password" placeholder="Enter new password" required minlength="8" />
                <i class="fas fa-eye-slash password-toggle" id="toggleNewPassword"></i>
              </div>
              <div class="password-strength">
                <div class="strength-bar" id="strengthBar"></div>
              </div>
            </div>

            <div class="form-group">
              <label for="confirmPassword">Confirm Password</label>
              <div class="input-wrapper">
                <i class="fas fa-lock input-icon"></i>
                <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password" required />
                <i class="fas fa-eye-slash password-toggle" id="toggleConfirmPassword"></i>
              </div>
            </div>

            <button type="submit" class="btn primary signup-btn">Reset Password</button>
          </form>

          <div class="signup-footer">
            <p>Remember your password? <a href="/user/login">Sign in here</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="section footer">
    <div class="container footer-inner">
      <div class="footer-left">
        <div class="logo">HOOF</div>
        <p class="footer-text">Premium sneakers designed to complement your everyday journey with style, comfort, and durability.</p>
        <div class="footer-social">
          <a href="#"><i class="fa-brands fa-instagram"></i></a>
          <a href="#"><i class="fa-solid fa-phone"></i></a>
          <a href="#"><i class="fa-brands fa-whatsapp"></i></a>
        </div>
      </div>
      <div class="footer-right">
        <h4>Malappuram</h4>
        <p>HOOF Sneaker House</p>
        <p>+91 98765 43210</p>
        <p>support@hoofsnkrs.com</p>
      </div>
    </div>
  </footer>

  <script src="/user/js/reset-password.js" defer></script>
</body>
</html>

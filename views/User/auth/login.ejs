<% locals.showBackButton=true %>
  <link rel="stylesheet" href="/user/css/login.css" />

  <section class="section login-hero">
    <div class="container">
      <div class="login-container">
        <div class="login-card">
          <div class="login-header">
            <h1 class="login-title">Welcome Back</h1>
            <p class="login-subtitle">Sign in to your HOOF account</p>
          </div>

          <% if (typeof successMessage !=="undefined" && successMessage) { %>
            <div class="server-message success">
              <i class="fas fa-check-circle"></i>
              <%= successMessage %>
            </div>
            <% } %>

              <% if (typeof error !=="undefined" && error) { %>
                <div class="server-message error">
                  <%= error %>
                </div>
                <% } %>

                  <form class="login-form" id="loginForm" action="/user/login" method="POST">
                    <div class="form-group">
                      <label for="loginEmail">Email Address</label>
                      <div class="input-wrapper">
                        <i class="fas fa-envelope input-icon"></i>
                        <input type="email" id="loginEmail" name="email" placeholder="Enter your email" required
                          value="<%= typeof email !== 'undefined' ? email : '' %>" />
                      </div>
                      <small class="error-message"></small>
                    </div>

                    <div class="form-group">
                      <label for="loginPassword">Password</label>
                      <div class="input-wrapper">
                        <i class="fas fa-lock input-icon"></i>
                        <input type="password" id="loginPassword" name="password" placeholder="Enter your password"
                          required />
                        <i class="fas fa-eye password-toggle" id="togglePassword"></i>
                      </div>
                      <small class="error-message"></small>
                    </div>

                    <div class="login-actions">
                      <a href="/user/forgot-password" class="forgot-password">
                        Forgot Password?
                      </a>
                    </div>

                    <button type="submit" class="btn primary login-btn">
                      Sign In
                    </button>
                  </form>

                  <div class="login-divider">
                    <span>or</span>
                  </div>


                  <a href="/auth/google" class="btn google-signup">
                    <i class="fab fa-google"></i> Continue with Google
                  </a>

                  <div class="login-footer">
                    <p>
                      Don't have an account?
                      <a href="/user/signup">Sign up here</a>
                    </p>
                  </div>
        </div>
      </div>
    </div>
  </section>

  <script src="/user/js/login.js" defer></script>
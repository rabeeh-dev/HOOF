<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign Up | HOOF</title>
  <link rel="stylesheet" href="/user/css/register.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="icon" type="image/x-icon" href="./images/favicon.ico">
</head>
<body>
  <!-- NAVBAR -->
  <header class="topbar">
    <div class="container nav-inner">
      <a href="javascript:history.back()" class="nav-back" aria-label="Go back">
  <i class="fa-solid fa-arrow-left"></i>
</a>

      <div class="logo">HOOF</div>
      <nav class="nav">
        <ul class="nav-links">
          <li><a href="home.html#home">Home</a></li>
          <li><a href="index.html#about">About</a></li>
          <li><a href="home.html#products">Shop</a></li>
          <li><a href="index.html#contact">Contact</a></li>
        </ul>
        <div class="nav-actions">
          <a href="#" class="nav-icon" title="Wishlist"><i class="far fa-heart"></i><span class="nav-badge">0</span></a>
          <a href="#" class="nav-icon cart-icon" title="Cart"><i class="fas fa-shopping-bag"></i><span class="nav-badge cart-count">0</span></a>
          
        </div>
        <button class="nav-toggle" id="nav-toggle">
          <span></span><span></span><span></span>
        </button>
      </nav>
    </div>
  </header>

  <!-- SIGNUP SECTION -->
  <section class="section signup-hero">
    <div class="container">
      <div class="signup-container">
        <div class="signup-card">
          <div class="signup-header">
            <h1 class="signup-title">Create Account</h1>
            <p class="signup-subtitle">Join HOOF and get access to exclusive drops</p>
          </div>

          <form class="signup-form" id="signupForm" action="/user/signup" method="POST">
            <div class="form-group">
              <label for="fullName">Full Name</label>
              <div class="input-wrapper">
                <i class="fas fa-user input-icon"></i>
                <input type="text" id="fullName" name="fullName" placeholder="Enter your full name" required />
              </div>
            </div>

            <div class="form-group">
              <label for="email">Email Address</label>
              <div class="input-wrapper">
                <i class="fas fa-envelope input-icon"></i>
                <input type="email" id="email" name="email" placeholder="Enter your email" required />
              </div>
            </div>

            <div class="form-group">
              <label for="password">Password</label>
              <div class="input-wrapper">
                <i class="fas fa-lock input-icon"></i>
                <input type="password" id="password" name="password" placeholder="Create password" required />
              </div>
            </div>

            <div class="form-group">
              <label for="confirmPassword">Confirm Password</label>
              <div class="input-wrapper">
                <i class="fas fa-lock input-icon"></i>
                <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm password" required />
              </div>
            </div>

            <div class="form-check">
              <input type="checkbox" id="terms" name="terms" required />
              <label for="terms">I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a></label>
            </div>

            <button type="submit" class="btn primary signup-btn">Create Account</button>
          </form>

          <div class="signup-divider">
            <span>or</span>
          </div>
          
          <button type="button" class="btn google-signup">
            <a href="/auth/google">
              <i class="fab fa-google"></i> Continue with Google
            </a>
          </button>

          <div class="signup-footer">
            <p>Already have an account? <a href="#">Sign in here</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="section footer">
    <div class="container footer-inner">
      <div class="footer-left">
        <div class="logo">HOOF</div>
        <p class="footer-text">Premium sneakers designed to complement your everyday journey with style, comfort, and durability.</p>
        <div class="footer-social">
          <a href="#"><i class="fa-brands fa-instagram"></i></a>
          <a href="#"><i class="fa-solid fa-phone"></i></a>
          <a href="#"><i class="fa-brands fa-whatsapp"></i></a>
        </div>
      </div>
      
      <div class="footer-right">
        <h4>Malappuram</h4>
        <p>HOOF Sneaker House</p>
        <p>+91 98765 43210</p>
        <p>support@hoofsnkrs.com</p>
      </div>
    </div>
  </footer>

  <script src="/user/js/register.js" defer></script>
</body>
</html>

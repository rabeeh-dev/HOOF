<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password | HOOF</title>
  <link rel="stylesheet" href="/user/css/forgot-password.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="icon" type="image/x-icon" href="./images/favicon.ico">
</head>
<body>
  <!-- NAVBAR (EXACT SAME) -->
  <header class="topbar">
    <div class="container nav-inner">
      <a href="javascript:history.back()" class="nav-back" aria-label="Go back">
        <i class="fa-solid fa-arrow-left"></i>
      </a>
      <div class="logo">HOOF</div>
      <nav class="nav">
        <ul class="nav-links">
          <li><a href="home.html#home">Home</a></li>
          <li><a href="index.html#about">About</a></li>
          <li><a href="home.html#products">Shop</a></li>
          <li><a href="index.html#contact">Contact</a></li>
        </ul>
        <div class="nav-actions">
          <a href="#" class="nav-icon" title="Wishlist"><i class="far fa-heart"></i><span class="nav-badge">0</span></a>
          <a href="#" class="nav-icon cart-icon" title="Cart"><i class="fas fa-shopping-bag"></i><span class="nav-badge cart-count">0</span></a>
        </div>
        <button class="nav-toggle" id="nav-toggle">
          <span></span><span></span><span></span>
        </button>
      </nav>
    </div>
  </header>

  <!-- FORGOT PASSWORD SECTION -->
  <section class="section login-hero">
    <div class="container">
      <div class="login-container">
        <div class="login-card">
          <div class="login-header">
            <div class="forgot-icon">
              <i class="fas fa-key"></i>
            </div>
            <h1 class="login-title">Forgot Password?</h1>
            <p class="login-subtitle">No worries, we'll send you reset instructions</p>
          </div>

          <!-- ✅ MESSAGE BLOCK (ADDED) -->
          <% if (message) { %>
  <div class="server-message success">
    <%= message %>
  </div>
<% } %>


          <form class="login-form" id="forgotPasswordForm" action="/user/forgot-password" method="POST">
            <div class="form-group">
              <label for="resetEmail">Email Address</label>
              <div class="input-wrapper">
                <i class="fas fa-envelope input-icon"></i>
                <input
                  type="email"
                  id="resetEmail"
                  name="email"
                  placeholder="Enter your registered email"
                  required
                />
              </div>
            </div>

            <button type="submit" class="btn primary login-btn">
              <span class="btn-text">Send Reset Link</span>
              <span class="btn-loader" style="display: none;">
                <i class="fas fa-spinner fa-spin"></i> Sending...
              </span>
            </button>
          </form>

          <div class="login-footer">
            <p>
              <a href="/user/login" class="back-to-login">
                <i class="fas fa-arrow-left"></i> Back to Login
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER (EXACT SAME - 2 columns) -->
  <footer class="section footer">
    <div class="container footer-inner">
      <div class="footer-left">
        <div class="logo">HOOF</div>
        <p class="footer-text">Premium sneakers designed to complement your everyday journey with style, comfort, and durability.</p>
        <div class="footer-social">
          <a href="#"><i class="fa-brands fa-instagram"></i></a>
          <a href="#"><i class="fa-solid fa-phone"></i></a>
          <a href="#"><i class="fa-brands fa-whatsapp"></i></a>
        </div>
      </div>
      <div class="footer-right">
        <h4>Malappuram</h4>
        <p>HOOF Sneaker House</p>
        <p>+91 98765 43210</p>
        <p>support@hoofsnkrs.com</p>
      </div>
    </div>
  </footer>

  <script src="/user/js/forgot-password.js" defer></script>
</body>
</html>

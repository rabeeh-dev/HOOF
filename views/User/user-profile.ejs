<link rel="stylesheet" href="/user/css/user-profile.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">
<style>
  .validation-message {
    font-size: 0.8rem;
    height: 1.2em;
    display: block;
    margin-top: 4px;
  }

  .validation-message.error {
    color: #dc3545;
  }

  .validation-message.success {
    color: #28a745;
  }

  input.invalid {
    border-color: #dc3545 !important;
  }

  input.valid {
    border-color: #28a745 !important;
  }
</style>

<section class="profile-section">
  <div class="container">
    <div class="profile-header-title">
      <h1>My Profile</h1>
      <p>Manage your account</p>
    </div>

    <div class="profile-layout">
      <div class="profile-sidebar">
        <div class="profile-card">
          <div class="profile-avatar-wrapper">
            <div class="profile-avatar" id="profileAvatar">
              <% if (user.profileImage) { %>
                <img src="<%= user.profileImage %>" id="avatarImg" alt="Profile">
                <% } else { %>
                  <span id="avatarLetter">
                    <%= user.fullName.charAt(0) %>
                  </span>
                  <% } %>
            </div>
            <label for="imageUpload" class="avatar-edit-icon"><i class="fas fa-camera"></i><input type="file"
                id="imageUpload" hidden accept="image/*"></label>
            <button type="button" id="removePhotoBtn" class="avatar-remove-icon" <% if (!user.profileImage) {
              %>style="display: none;"<% } %>><i class="fas fa-times"></i></button>
          </div>
          <h3 class="profile-name" id="sidebarName">
            <%= user.fullName %>
          </h3>
          <button class="btn-edit-profile" id="editToggleBtn">Edit Profile</button>
          <div class="profile-stats">
            <div class="stat-item">
              <p class="stat-label">Member Since</p>
              <p class="stat-value">
                <%= new Date(user.createdAt).toLocaleString('default', { month: 'short' , year: 'numeric' }) %>
              </p>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
              <p class="stat-label">Auth</p>
              <p class="stat-value" style="text-transform: capitalize;">
                <%= user.authProvider %>
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="profile-main">
        <% if (typeof successMessage !=='undefined' && successMessage) { %>
          <div id="successPopupModal" class="custom-modal" style="display: flex;">
            <div class="modal-overlay"></div>
            <div class="modal-container" style="max-width: 420px; text-align: center;">
              <div class="modal-header" style="justify-content: center; border: none; padding-bottom: 0;">
                <div
                  style="background: rgba(40, 167, 69, 0.1); width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px;">
                  <i class="fas fa-check-circle" style="font-size: 2.5rem; color: #28a745;"></i>
                </div>
              </div>
              <h3 style="font-size: 1.5rem; margin-bottom: 10px;">Success!</h3>
              <p style="color: #666; margin-bottom: 25px; line-height: 1.6;">
                <%= successMessage %>
              </p>
              <div class="modal-footer" style="display: flex; gap: 12px; border: none; padding: 0;">
                <button type="button" id="closeSuccessPopup" class="btn primary" style="flex: 1;">OK</button>
              </div>
            </div>
          </div>
          <% } %>

            <div class="profile-tabs">
              <button class="tab-btn active" data-tab="details"><i
                  class="fas fa-user-circle"></i><span>Details</span></button>
              <button class="tab-btn" data-tab="orders"><i class="fas fa-box"></i><span>Orders</span></button>
              <button class="tab-btn" data-tab="wallet"><i class="fas fa-wallet"></i><span>Wallet</span></button>
              <button class="tab-btn" data-tab="referral"><i class="fas fa-gift"></i><span>Referral</span></button>
              <a href="/user/address" class="tab-btn" style="text-decoration: none;"><i
                  class="fa fa-location-arrow"></i><span>Address</span></a>
              <button class="tab-btn" data-tab="faq"><i class="fas fa-question-circle"></i><span>FAQ</span></button>
            </div>

            <div class="tab-content-wrapper">
              <div class="tab-content active" id="details-tab">
                <div class="content-header">
                  <h2>Account Details</h2>
                </div>
                <form class="profile-form" id="profileForm">
                  <div class="form-row">
                    <div class="form-group"><label for="fullName">Full Name</label><input type="text" id="fullName"
                        name="fullName" value="<%= user.fullName %>" disabled /></div>
                    <div class="form-group">
                      <label for="emailAddress">Email Address</label>
                      <div class="password-input-wrapper"><input type="email" value="<%= user.email %>" disabled />
                        <% if (user.authProvider==='google' ) { %>
                          <a href="javascript:void(0)" class="change-password-link"
                            style="color: grey; pointer-events: none; opacity: 0.6; cursor: not-allowed;">Change
                            Email</a>
                          <% } else { %>
                            <a href="javascript:void(0)" class="change-password-link"
                              onclick="verifyAndChange('email')">Change Email</a>
                            <% } %>
                      </div>
                    </div>
                  </div>
                  <div class="form-row">
                    <div class="form-group"><label for="phoneNumber">Phone Number</label><input type="tel"
                        id="phoneNumber" name="phoneNumber" value="<%= user.phone || '' %>" placeholder="Not set"
                        disabled /><small class="validation-message" id="phoneError"></small></div>
                    <div class="form-group"><label for="dateOfBirth">Date of Birth</label><input type="date"
                        id="dateOfBirth" name="dateOfBirth"
                        value="<%= user.dob ? user.dob.toISOString().split('T')[0] : '' %>" disabled /><small
                        class="validation-message" id="dobError"></small></div>
                  </div>
                  <div class="form-group">
                    <label for="password">Password</label>
                    <div class="password-input-wrapper"><input type="password" value="••••••••••••••••" disabled />
                      <% if (user.authProvider==='google' ) { %>
                        <a href="javascript:void(0)" class="change-password-link"
                          style="color: grey; pointer-events: none; opacity: 0.6; cursor: not-allowed;">Update
                          Password</a>
                        <% } else { %>
                          <a href="javascript:void(0)" class="change-password-link"
                            onclick="verifyAndChange('password')">Update Password</a>
                          <% } %>
                    </div>
                  </div>
                  <div class="form-actions" id="formActions" style="display: none;"><button type="submit"
                      class="btn primary">Save Changes</button><button type="button" class="btn outline"
                      id="cancelEdit">Cancel</button></div>
                </form>
              </div>

            </div>
      </div>
    </div>
  </div>
</section>

<div id="cropperModal" class="custom-modal" style="display:none;">
  <div class="modal-overlay"></div>
  <div class="modal-container" style="max-width: 500px;">
    <div class="modal-header">
      <h3>Crop Profile Picture</h3><button type="button" id="closeCropperHeader"
        style="background:none; border:none; font-size: 1.5rem; cursor:pointer;">&times;</button>
    </div>
    <div
      style="width: 100%; height: 350px; background: #f0f0f0; border-radius: 12px; overflow: hidden; margin-bottom: 20px;">
      <img id="cropperImage" src="" style="max-width: 100%; display: block;">
    </div>
    <div class="modal-actions" style="display: flex; gap: 12px;"><button type="button" id="cropButton"
        class="btn primary" style="flex: 1;">Crop & Save</button><button type="button" id="closeCropper"
        class="btn outline" style="flex: 1;">Cancel</button></div>
  </div>
</div>



<div id="imageDeleteModal" class="custom-modal" style="display:none;">
  <div class="modal-overlay"></div>
  <div class="modal-container" style="max-width: 420px; text-align: center;">
    <div class="modal-header" style="justify-content: center; border: none; padding-bottom: 0;">
      <div
        style="background: rgba(220, 53, 69, 0.1); width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px;">
        <i class="fas fa-trash-alt" style="font-size: 2.5rem; color: #dc3545;"></i>
      </div>
    </div>
    <h3 style="font-size: 1.5rem; margin-bottom: 10px;">Remove Photo?</h3>
    <p style="color: #666; margin-bottom: 25px; line-height: 1.6;">Are you sure you want to delete your profile
      picture? This action will revert your avatar to your initials.</p>
    <div class="modal-footer" style="display: flex; gap: 12px; border: none; padding: 0;"><button type="button"
        id="confirmImageDelete" class="btn primary"
        style="flex: 1; background: #dc3545; border-color: #dc3545; color: white;">Yes, Delete</button><button
        type="button" id="cancelImageDelete" class="btn outline" style="flex: 1;">Cancel</button></div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/heic2any@0.0.3/dist/heic2any.min.js"></script>
<script src="/user/js/user-profile.js" defer></script>
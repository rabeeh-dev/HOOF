<style>
    :root {
        --bg-main: #869897;
        --bg-band: #8ea39e;
        --text-main: #0f1514;
        --text-light: #f5f8f7;
        --accent: #ff914d;
        --accent-dark: #e26820;
    }

    /* Sneaker icon */
    .sneaker-icon {
        font-size: clamp(4rem, 10vw, 6rem);
        margin-bottom: 2rem;
        display: inline-block;
        animation: float 3.5s ease-in-out infinite;
        filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.2));
    }

    @keyframes float {

        0%,
        100% {
            transform: translateY(0) rotate(-10deg);
        }

        50% {
            transform: translateY(-20px) rotate(-10deg);
        }
    }

    .error-container {
        text-align: center;
        padding: 5rem 2rem;
        background: linear-gradient(135deg, var(--bg-main) 0%, var(--bg-band) 100%);
        min-height: 70vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .error-number {
        font-family: silver;
        font-size: clamp(8rem, 20vw, 14rem);
        line-height: 1;
        letter-spacing: 0.1em;
        color: var(--text-light);
        margin-bottom: 1rem;
        text-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    h3.error-title {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--text-light);
    }

    .error-message {
        font-size: clamp(1rem, 2vw, 1.2rem);
        font-weight: 300;
        line-height: 1.6;
        color: var(--text-light);
        opacity: 0.9;
        margin-bottom: 3rem;
        max-width: 500px;
    }

    .btn-home {
        border-radius: 999px;
        padding: 1rem 2.5rem;
        border: none;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        font-family: "Poppins", sans-serif;
        background: var(--accent);
        color: var(--text-light);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
        text-decoration: none;
        display: inline-block;
    }

    .btn-home:hover {
        background: var(--accent-dark);
        transform: translateY(-2px);
        box-shadow: 0 16px 32px rgba(0, 0, 0, 0.4);
    }
</style>

<div class="error-container">
    <div class="error-number">404</div>
    <div class="sneaker-icon">👟</div>
    <h3 class="error-title">Page Not Found</h3>
    <p class="error-message">
        The page you're looking for has walked away. It might have been moved or doesn't exist anymore.
    </p>
    <a href="/user/home" class="btn-home">Back to Home</a>
</div>
<link rel="stylesheet" href="/user/css/user-profile.css" />
<link rel="stylesheet" href="/user/css/referral.css" />

<section class="profile-section">
    <div class="container">
        <div class="profile-header-title">
            <h1>Referral Program</h1>
            <p>Invite friends and earn rewards</p>
        </div>

        <div class="profile-layout">

            <!-- SIDEBAR -->
            <div class="profile-sidebar">
                <div class="profile-card">
                    <div class="profile-avatar-wrapper">
                        <div class="profile-avatar">
                            <% if (user.profileImage) { %>
                                <img src="<%= user.profileImage %>" alt="Profile">
                                <% } else { %>
                                    <span>
                                        <%= user.fullName.charAt(0) %>
                                    </span>
                                    <% } %>
                        </div>
                    </div>
                    <h3 class="profile-name">
                        <%= user.fullName %>
                    </h3>
                    <a href="/user/profile" class="btn-edit-profile"
                        style="text-decoration:none;display:flex;justify-content:center;align-items:center;gap:8px;">
                        <i class="fas fa-arrow-left"></i>Back to Profile
                    </a>

                    <!-- REFERRAL STATS -->
                    <div class="order-stats-strip">
                        <div class="stat-item">
                            <div class="stat-value" style="color: var(--accent);">
                                <%= user.referralPoints || 0 %>
                            </div>
                            <div class="stat-label">Points</div>
                        </div>
                        <div class="stat-divider"></div>
                        <div class="stat-item">
                            <div class="stat-value" style="color:#27ae60;">₹<%= ((user.referralPoints || 0) /
                                    (referralConfig.pointsPerRupee || 100)).toFixed(2) %>
                            </div>
                            <div class="stat-label">Value</div>
                        </div>
                        <div class="stat-divider"></div>
                        <div class="stat-item">
                            <div class="stat-value" style="color:#3498db;">
                                <%= referredCount || 0 %>
                            </div>
                            <div class="stat-label">Referred</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- MAIN CONTENT -->
            <div class="profile-main">
                <div class="tab-content-wrapper">

                    <!-- REFERRAL CODE CARD -->
                    <div class="referral-code-card">
                        <div class="referral-code-bg">
                            <div class="referral-code-icon">
                                <i class="fas fa-share-alt"></i>
                            </div>
                            <div class="referral-code-info">
                                <span class="referral-code-label">Your Referral Code</span>
                                <div class="referral-code-display">
                                    <span class="referral-code-text" id="referralCode">
                                        <%= user.referralCode %>
                                    </span>
                                    <button class="referral-copy-btn" id="copyCodeBtn" onclick="copyReferralCode()">
                                        <i class="fas fa-copy"></i> Copy
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="referral-code-subtext">
                            <i class="fas fa-info-circle"></i>
                            Share this code with friends. When they sign up using your code, you earn <strong><%= referralConfig.pointsPerReferral %>
                                points</strong>!
                        </div>
                    </div>

                    <!-- REWARDS CARD -->
                    <div class="referral-rewards-card">
                        <div class="content-header" style="margin-bottom: 24px;">
                            <h2><i class="fas fa-gift" style="color: var(--accent); margin-right: 8px;"></i>Your Rewards
                            </h2>
                        </div>

                        <div class="rewards-grid">
                            <div class="reward-stat-card">
                                <div class="reward-stat-icon points">
                                    <i class="fas fa-coins"></i>
                                </div>
                                <div class="reward-stat-info">
                                    <span class="reward-stat-value" id="totalPoints">
                                        <%= user.referralPoints || 0 %>
                                    </span>
                                    <span class="reward-stat-label">Total Points</span>
                                </div>
                            </div>

                            <div class="reward-stat-card">
                                <div class="reward-stat-icon value">
                                    <i class="fas fa-rupee-sign"></i>
                                </div>
                                <div class="reward-stat-info">
                                    <span class="reward-stat-value" id="totalValue">₹<%= ((user.referralPoints || 0) /
                                            (referralConfig.pointsPerRupee || 100)).toFixed(2) %></span>
                                    <span class="reward-stat-label">Wallet Value</span>
                                </div>
                            </div>

                            <div class="reward-stat-card">
                                <div class="reward-stat-icon friends">
                                    <i class="fas fa-user-friends"></i>
                                </div>
                                <div class="reward-stat-info">
                                    <span class="reward-stat-value">
                                        <%= referredCount || 0 %>
                                    </span>
                                    <span class="reward-stat-label">Friends Referred</span>
                                </div>
                            </div>
                        </div>

                        <!-- CONVERSION INFO -->
                        <div class="conversion-info">
                            <div class="conversion-row">
                                <i class="fas fa-exchange-alt"></i>
                                <span><strong><%= referralConfig.pointsPerRupee %> points</strong> = <strong>₹1.00</strong></span>
                            </div>
                            <div class="conversion-row">
                                <i class="fas fa-wallet"></i>
                                <span>Withdraw your earnings directly to your <strong>HOOF Wallet</strong></span>
                            </div>
                            <div class="conversion-row">
                                <i class="fas fa-shopping-bag"></i>
                                <span>Use wallet balance to pay for orders at checkout</span>
                            </div>
                        </div>

                        <!-- WITHDRAW SECTION -->
                        <div class="withdraw-section">
                            <div class="withdraw-info">
                                <span class="withdraw-available">Available: <strong id="withdrawPoints">
                                        <%= user.referralPoints || 0 %> points
                                    </strong></span>
                                <span class="withdraw-value">(₹<span id="withdrawValue">
                                        <%= ((user.referralPoints || 0) / (referralConfig.pointsPerRupee || 100)).toFixed(2) %>
                                    </span>)</span>
                            </div>
                            <button class="withdraw-btn" id="withdrawBtn" onclick="withdrawToWallet()" <% if
                                ((user.referralPoints || 0) < (referralConfig.minWithdrawPoints || 100)) { %>disabled<% } %>>
                                    <i class="fas fa-wallet"></i> Withdraw to Wallet
                            </button>
                            <% if ((user.referralPoints || 0) < (referralConfig.minWithdrawPoints || 100)) { %>
                                <small class="withdraw-hint">Minimum <%= referralConfig.minWithdrawPoints %> points (₹<%= (referralConfig.minWithdrawPoints / referralConfig.pointsPerRupee).toFixed(2) %>) required to withdraw</small>
                                <% } %>
                        </div>
                    </div>

                    <!-- HOW IT WORKS -->
                    <div class="referral-how-it-works">
                        <div class="content-header" style="margin-bottom: 24px;">
                            <h2><i class="fas fa-question-circle"
                                    style="color: var(--accent); margin-right: 8px;"></i>How It Works</h2>
                        </div>
                        <div class="steps-grid">
                            <div class="step-card">
                                <div class="step-number">1</div>
                                <div class="step-icon"><i class="fas fa-share-alt"></i></div>
                                <h4>Share Your Code</h4>
                                <p>Copy your unique referral code and share it with friends</p>
                            </div>
                            <div class="step-card">
                                <div class="step-number">2</div>
                                <div class="step-icon"><i class="fas fa-user-plus"></i></div>
                                <h4>Friend Signs Up</h4>
                                <p>Your friend creates an account using your referral code</p>
                            </div>
                            <div class="step-card">
                                <div class="step-number">3</div>
                                <div class="step-icon"><i class="fas fa-coins"></i></div>
                                <h4>Earn Points</h4>
                                <p>You receive <%= referralConfig.pointsPerReferral %> points for each successful referral</p>
                            </div>
                            <div class="step-card">
                                <div class="step-number">4</div>
                                <div class="step-icon"><i class="fas fa-wallet"></i></div>
                                <h4>Withdraw</h4>
                                <p>Convert your points to wallet balance (<%= referralConfig.pointsPerRupee %> pts = ₹1)</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<!-- Toast notification -->
<div class="referral-toast" id="referralToast">
    <i class="fas fa-check-circle"></i>
    <span id="toastMessage">Copied!</span>
</div>

<script src="/user/js/referral.js" defer></script>
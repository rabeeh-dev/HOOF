<link rel="stylesheet" href="/user/css/product-details.css">

<section class="product-details-section">
    <div class="container">
        <div class="product-details-container">
            <!-- Left: Image Gallery -->
            <div class="product-gallery">
                <div class="main-image">
                    <img src="<%= product.productImage[0] %>" alt="<%= product.productName %>" id="mainImage">
                    <div id="outOfStockOverlay" class="stock-overlay" style="display: none;">
                        <span>Out of Stock</span>
                    </div>
                </div>
                <div class="thumbnail-list">
                    <% product.productImage.forEach((img, index)=> { %>
                        <div class="thumbnail <%= index === 0 ? 'active' : '' %>"
                            onclick="changeImage(this, '<%= img %>')">
                            <img src="<%= img %>" alt="Thumbnail">
                        </div>
                        <% }) %>
                </div>
            </div>

            <!-- Right: Product Info -->
            <div class="product-info-col">
                <p class="product-brand">
                    <%= product.brand %>
                </p>
                <h1 class="product-title">
                    <%= product.productName %>
                </h1>

                <div class="product-rating">
                    <div class="stars">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star-half-alt"></i>
                    </div>
                    <span class="review-count">(120 Reviews)</span>
                </div>

                <div class="product-price">
                    <% if (product.salePrice < product.regularPrice) { %>
                        <span class="sale-price">₹<%= product.salePrice.toLocaleString() %></span>
                        <span class="regular-price">₹<%= product.regularPrice.toLocaleString() %></span>
                        <span class="discount-badge">
                            <%= Math.round(((product.regularPrice - product.salePrice) / product.regularPrice) * 100) %>
                                % OFF
                        </span>
                        <% } else { %>
                            <span class="sale-price">₹<%= product.regularPrice.toLocaleString() %></span>
                            <% } %>
                </div>

                <div class="product-description">
                    <%= product.description %>
                </div>

                <div class="product-variants">
                    <label class="variant-label"><i class="fas fa-ruler"></i> Select Size:</label>
                    <div class="size-selector">
                        <% const sizes=[6, 7, 8, 9]; %>
                            <% sizes.forEach(size=> {
                                const variant = product.variants.find(v => v.size == size);
                                const stock = variant ? variant.quantity : 0;
                                %>
                                <div class="size-option" data-size="<%= size %>" data-stock="<%= stock %>"
                                    onclick="selectSize(this)">
                                    <%= size %>
                                </div>
                                <% }) %>
                    </div>
                    <p id="stockStatus" class="stock-status">Select a size to see availability</p>
                </div>

                <div class="product-actions">
                    <div class="quantity-selector">
                        <button onclick="updateQuantity(-1)"><i class="fas fa-minus"></i></button>
                        <input type="number" id="quantity" value="1" min="1" max="5" readonly>
                        <button onclick="updateQuantity(1)"><i class="fas fa-plus"></i></button>
                    </div>

                    <div class="action-buttons-group">
                        <button class="btn btn-add-cart" id="addToCartBtn" onclick="addToCart('<%= product._id %>')"
                            disabled>
                            <i class="fas fa-shopping-bag"></i>
                        </button>
                        <button class="btn btn-buy-now" id="buyNowBtn" onclick="buyNow('<%= product._id %>')" disabled>
                            Buy Now
                        </button>
                    </div>

                    <% const isInWishlist=typeof wishlistProductIds !=='undefined' &&
                        wishlistProductIds.includes(product._id.toString()); %>
                        <button class="btn btn-wishlist <%= isInWishlist ? 'active' : '' %>"
                            onclick="toggleWishlist(this, '<%= product._id %>')">
                            <i class="<%= isInWishlist ? 'fas' : 'far' %> fa-heart"></i>
                        </button>
                </div>

                <div class="product-meta">
                    <div class="meta-item">
                        <i class="fas fa-truck"></i>
                        <span>Free Delivery</span>
                    </div>
                    <div class="meta-item">
                        <i class="fas fa-undo"></i>
                        <span>30 Days Return</span>
                    </div>
                    <div class="meta-item">
                        <i class="fas fa-shield-alt"></i>
                        <span>1 Year Warranty</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Related Products -->
        <% if (relatedProducts && relatedProducts.length> 0) { %>
            <div class="related-products-section">
                <h2 class="section-title">You May Also Like</h2>
                <div class="related-products-grid">
                    <% relatedProducts.forEach(prod=> { %>
                        <div class="product-card"
                            onclick="window.location.href='/user/product-details/<%= prod._id %>'">
                            <div class="product-image-wrapper">
                                <img src="<%= prod.productImage[0] %>" alt="<%= prod.productName %>">
                                <% const isRelatedInWishlist=typeof wishlistProductIds !=='undefined' &&
                                    wishlistProductIds.includes(prod._id.toString()); %>
                                    <button class="card-wishlist-btn <%= isRelatedInWishlist ? 'active' : '' %>"
                                        onclick="event.stopPropagation(); toggleWishlist(this, '<%= prod._id %>')">
                                        <i class="<%= isRelatedInWishlist ? 'fas' : 'far' %> fa-heart"></i>
                                    </button>
                                    <% if (prod.salePrice < prod.regularPrice) { %>
                                        <span class="card-badge">Sale</span>
                                        <% } %>
                            </div>
                            <div class="product-card-info">
                                <h3 class="product-name">
                                    <%= prod.productName %>
                                </h3>
                                <div class="price-row">
                                    <span class="current-price">₹<%= prod.salePrice.toLocaleString() %></span>
                                    <% if (prod.salePrice < prod.regularPrice) { %>
                                        <span class="original-price">₹<%= prod.regularPrice.toLocaleString() %></span>
                                        <% } %>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                </div>
            </div>
            <% } %>

                <!-- Reviews Section -->
                <div class="reviews-section" id="reviews">
                    <h2 class="section-title">Customer Reviews</h2>

                    <div class="reviews-container">
                        <!-- Left: Review Listing -->
                        <div class="reviews-list-col">
                            <% if (reviews && reviews.length> 0) { %>
                                <% reviews.forEach(review=> { %>
                                    <div class="review-item">
                                        <div class="review-header">
                                            <div class="reviewer-info-left">
                                                <div class="reviewer-avatar">
                                                    <%= review.userId.fullName.charAt(0).toUpperCase() %>
                                                </div>
                                                <div class="reviewer-details">
                                                    <span class="reviewer-name">
                                                        <%= review.userId.fullName %>
                                                    </span>
                                                    <span class="review-date">
                                                        <%= new Date(review.createdAt).toLocaleDateString('en-IN', {
                                                            day: 'numeric' , month: 'short' , year: 'numeric' }) %>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="review-stars-ribbon">
                                                <div class="ribbon-stars">
                                                    <% for(let i=1; i<=5; i++) { %>
                                                        <i class="fa<%= i <= review.rating ? 's' : 'r' %> fa-star"></i>
                                                        <% } %>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="review-body">
                                            <p>
                                                <%= review.comment %>
                                            </p>
                                        </div>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <div class="no-reviews-premium">
                                                <div class="empty-icon-wrap">
                                                    <i class="far fa-comment-alt"></i>
                                                </div>
                                                <h3>No reviews yet</h3>
                                                <p>Be the first to share your thoughts about this product!</p>
                                            </div>
                                            <% } %>
                        </div>

                        <!-- Right: Add Review Form -->
                        <div class="add-review-col">
                            <% if (typeof hasPurchased !=='undefined' && hasPurchased && !hasReviewed) { %>
                                <div class="premium-review-form-card">
                                    <div class="form-card-header">
                                        <div class="form-icon">
                                            <i class="fas fa-pen-fancy"></i>
                                        </div>
                                        <h3>Write a Review</h3>
                                    </div>
                                    <form id="reviewForm" class="review-form">
                                        <input type="hidden" name="productId" value="<%= product._id %>">

                                        <div class="rating-group premium-group">
                                            <label>Your Rating</label>
                                            <div class="star-rating">
                                                <input type="radio" id="star5" name="rating" value="5" /><label
                                                    for="star5" class="fas fa-star"></label>
                                                <input type="radio" id="star4" name="rating" value="4" /><label
                                                    for="star4" class="fas fa-star"></label>
                                                <input type="radio" id="star3" name="rating" value="3" /><label
                                                    for="star3" class="fas fa-star"></label>
                                                <input type="radio" id="star2" name="rating" value="2" /><label
                                                    for="star2" class="fas fa-star"></label>
                                                <input type="radio" id="star1" name="rating" value="1" /><label
                                                    for="star1" class="fas fa-star"></label>
                                            </div>
                                        </div>

                                        <div class="form-group premium-group">
                                            <label for="comment">Your Comment</label>
                                            <textarea id="comment" name="comment" rows="4"
                                                placeholder="What did you like or dislike about this product?"
                                                required></textarea>
                                        </div>

                                        <button type="submit" class="btn btn-submit-review">
                                            <span>Submit Review</span>
                                            <i class="fas fa-paper-plane"></i>
                                        </button>
                                    </form>
                                </div>
                                <% } else if (typeof hasReviewed !=='undefined' && hasReviewed) { %>
                                    <div class="premium-review-form-card" style="padding: 3rem 2rem;">
                                        <div class="form-card-header"
                                            style="text-align: center; flex-direction: column; align-items: center; gap: 1.2rem;">
                                            <div class="form-icon"
                                                style="margin: 0 auto; width: 60px; height: 60px; font-size: 1.5rem; background: rgba(46, 204, 113, 0.1); color: #2ecc71; border-radius: 50%;">
                                                <i class="fas fa-check-circle"></i>
                                            </div>
                                            <h3 style="color: var(--text-main); margin: 0;">Thanks for your review!</h3>
                                            <p style="color: #718096; margin: 0; font-size: 0.95rem; line-height: 1.6;">
                                                You've already submitted a review for this product.
                                            </p>
                                        </div>
                                    </div>
                                    <% } else { %>
                                        <div class="premium-review-form-card" style="padding: 3rem 2rem;">
                                            <div class="form-card-header"
                                                style="text-align: center; flex-direction: column; align-items: center; gap: 1.2rem;">
                                                <div class="form-icon"
                                                    style="margin: 0 auto; width: 60px; height: 60px; font-size: 1.5rem; background: rgba(255, 145, 77, 0.1); color: var(--accent); border-radius: 50%;">
                                                    <i class="fas fa-shopping-bag"></i>
                                                </div>
                                                <h3 style="color: var(--text-main); margin: 0;">Purchase to Review</h3>
                                                <p
                                                    style="color: #718096; margin: 0; font-size: 0.95rem; line-height: 1.6;">
                                                    Only customers who have purchased and received this product can
                                                    write a review.
                                                </p>
                                            </div>
                                        </div>
                                        <% } %>
                        </div>
                    </div>
                </div>
    </div>
</section>



<script>
    document.getElementById('reviewForm')?.addEventListener('submit', async function (e) {
        e.preventDefault();
        const formData = new FormData(this);
        const data = Object.fromEntries(formData.entries());

        if (!data.rating) {
            Swal.fire({ icon: 'warning', title: 'Rating Required', text: 'Please select a star rating.' });
            return;
        }

        try {
            const res = await fetch(`/user/product/${data.productId}/review`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();

            if (result.success) {
                Swal.fire({ icon: 'success', title: 'Submitted!', text: result.message }).then(() => {
                    location.reload();
                });
            } else {
                Swal.fire({ icon: 'error', title: 'Oops', text: result.message });
            }
        } catch (err) {
            Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong' });
        }
    });
</script>

<script>
    let selectedSize = null;
    let maxStock = 0;

    function changeImage(thumb, src) {
        document.getElementById('mainImage').src = src;
        document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
        thumb.classList.add('active');
    }

    function selectSize(element) {
        // Reset styles
        document.querySelectorAll('.size-option').forEach(opt => opt.classList.remove('active'));
        element.classList.add('active');

        selectedSize = element.dataset.size;
        maxStock = parseInt(element.dataset.stock);

        const stockStatus = document.getElementById('stockStatus');
        const addToCartBtn = document.getElementById('addToCartBtn');
        const buyNowBtn = document.getElementById('buyNowBtn');
        const overlay = document.getElementById('outOfStockOverlay');

        if (maxStock > 0) {
            stockStatus.innerHTML = `<span class="in-stock"><i class="fas fa-check-circle"></i> In Stock (${maxStock} available)</span>`;
            stockStatus.className = 'stock-status visible received';

            addToCartBtn.disabled = false;
            addToCartBtn.innerHTML = '<i class="fas fa-shopping-bag"></i>';

            buyNowBtn.disabled = false;

            overlay.style.display = 'none';
        } else {
            stockStatus.innerHTML = `<span class="out-of-stock"><i class="fas fa-times-circle"></i> Not Available / Out of Stock</span>`;
            stockStatus.className = 'stock-status visible out';

            addToCartBtn.disabled = true;
            addToCartBtn.innerHTML = 'Out of Stock';

            buyNowBtn.disabled = true;

            overlay.style.display = 'flex'; // Show overlay
        }
    }

    function updateQuantity(change) {
        if (!selectedSize) {
            Swal.fire({
                icon: 'warning',
                title: 'Select Size',
                text: 'Please select a size first.',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000
            });
            return;
        }

        const input = document.getElementById('quantity');
        let currentVal = parseInt(input.value) || 1;
        let newVal = currentVal + change;

        // Min limit check
        if (newVal < 1) return;

        // Max limit check (Total 5)
        if (newVal > 5) {
            Swal.fire({
                icon: 'warning',
                title: 'Limit Exceeded',
                text: 'You can only add a maximum of 5 items per product.',
                confirmButtonColor: '#000'
            });
            return;
        }

        // Stock limit check
        if (newVal > maxStock) {
            Swal.fire({
                icon: 'error',
                title: 'Out of Stock',
                text: `Sorry, we only have ${maxStock} items available in this size.`,
                confirmButtonColor: '#d33'
            });
            return;
        }

        input.value = newVal;
    }

    async function addToCart(productId) {
        if (!selectedSize) {
            Swal.fire({
                icon: 'warning',
                title: 'Select Size',
                text: 'Please select a size before adding to cart',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000
            });
            return;
        }

        const quantity = parseInt(document.getElementById('quantity').value) || 1;

        // Frontend Limit Checks
        if (quantity > 5) {
            Swal.fire({
                icon: 'warning',
                title: 'Limit Exceeded',
                text: 'You can only add a maximum of 5 items per product.',
                confirmButtonColor: '#000'
            });
            return;
        }

        if (quantity > maxStock) {
            Swal.fire({
                icon: 'error',
                title: 'Out of Stock',
                text: `Sorry, we only have ${maxStock} items available in this size.`,
                confirmButtonColor: '#d33'
            });
            return;
        }

        const btn = document.getElementById('addToCartBtn');
        const originalContent = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

        try {
            const response = await fetch('/user/cart/add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    productId,
                    quantity,
                    size: selectedSize
                })
            });

            if (response.status === 401) {
                window.location.href = '/user/login';
                return;
            }

            const result = await response.json();

            if (result.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Added to Bag!',
                    html: `<div style="display:flex; align-items:center; gap:1rem; justify-content:center; margin-top:1rem;">
                            <img src="${document.getElementById('mainImage').src}" style="width:60px; height:60px; object-fit:cover; border-radius:8px;">
                            <div style="text-align:left;">
                                <p style="margin:0; font-weight:700; font-size:1rem;">${result.message || 'Product Added'}</p>
                                <p style="margin:0; font-size:0.9rem; color:#666;">Size: ${selectedSize} | Qty: ${quantity}</p>
                            </div>
                           </div>`,
                    showConfirmButton: false,
                    timer: 3000,
                    width: '400px',
                    padding: '1.5rem',
                    background: '#fff url(/user/images/confetti.png)', // detailed background optional
                    backdrop: `
                        rgba(0,0,123,0.1)
                        left top
                        no-repeat
                    `
                });

                // Update cart count if exists
                const badge = document.querySelector('.cart-count');
                if (badge) {
                    // Start from 0 if empty/NaN, else increment
                    const current = parseInt(badge.textContent) || 0;
                    // Ideally fetch fresh count, but incrementing works for now
                    badge.textContent = current + quantity; // Add specific quantity
                    badge.style.display = 'flex'; // Ensure it's visible
                }

                // --- Sync Wishlist State ---
                const wlBtn = document.querySelector('.btn-wishlist');
                if (wlBtn && wlBtn.classList.contains('active')) {
                    wlBtn.classList.remove('active');
                    const wlIcon = wlBtn.querySelector('i');
                    if (wlIcon) {
                        wlIcon.classList.remove('fas');
                        wlIcon.classList.add('far');
                    }

                    // Update Wishlist Count in Navbar
                    const wishlistBadge = document.querySelector('.nav-icon[title="Wishlist"] .nav-badge');
                    if (wishlistBadge) {
                        let currentWl = parseInt(wishlistBadge.textContent) || 0;
                        wishlistBadge.textContent = Math.max(0, currentWl - 1);
                    }
                }
            } else {
                if (result.message === 'Login required') {
                    window.location.href = '/user/login';
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: result.message || 'Could not add to cart',
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3000
                    });
                }
            }
        } catch (error) {
            console.error('Add to cart error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Something went wrong. Please try again.',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000
            });
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalContent;
        }
    }

    async function buyNow(productId) {
        if (!selectedSize) {
            Swal.fire({
                icon: 'warning',
                title: 'Select Size',
                text: 'Please select a size before proceeding',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000
            });
            return;
        }

        // Add to cart first, then redirect to checkout
        // This ensures the item is in the cart session

        const quantity = parseInt(document.getElementById('quantity').value) || 1;
        const btn = document.getElementById('buyNowBtn');
        const originalContent = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

        try {
            const response = await fetch('/user/cart/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ productId, quantity, size: selectedSize })
            });

            if (response.status === 401) {
                window.location.href = '/user/login';
                return;
            }

            const result = await response.json();

            if (result.success) {
                window.location.href = '/user/checkout';
            } else {
                if (result.message === 'Login required') {
                    window.location.href = '/user/login';
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: result.message || 'Could not proceed',
                    });
                }
            }
        } catch (error) {
            console.error('Buy now error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Something went wrong',
            });
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalContent;
        }
    }

    async function toggleWishlist(btn, productId) {
        const isActive = btn.classList.contains('active');
        const url = isActive ? `/user/wishlist/remove/${productId}` : '/user/wishlist/add';
        const method = isActive ? 'DELETE' : 'POST';
        const body = isActive ? {} : { productId };

        try {
            const response = await fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify(body)
            });

            if (response.status === 401) {
                window.location.href = '/user/login';
                return;
            }

            const result = await response.json();

            if (result.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Wishlist',
                    text: result.message,
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000
                });

                // Update Wishlist Count in Navbar
                const wishlistBadge = document.querySelector('.nav-icon[title="Wishlist"] .nav-badge');
                if (wishlistBadge) {
                    let current = parseInt(wishlistBadge.textContent) || 0;
                    wishlistBadge.textContent = isActive ? Math.max(0, current - 1) : current + 1;
                }

                // Toggle Visual State
                const icon = btn.querySelector('i');
                if (isActive) {
                    btn.classList.remove('active');
                    if (icon) {
                        icon.classList.remove('fas');
                        icon.classList.add('far');
                    }
                } else {
                    btn.classList.add('active');
                    if (icon) {
                        icon.classList.remove('far');
                        icon.classList.add('fas');
                    }
                }

            } else {
                if (result.message === 'Login required') {
                    window.location.href = '/user/login';
                } else {
                    Swal.fire({
                        icon: 'info',
                        text: result.message,
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3000
                    });
                }
            }
        } catch (error) {
            console.error('Wishlist error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Something went wrong',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000
            });
        }
    }

    // Image Zoom Logic
    const mainImageContainer = document.querySelector('.main-image');
    const mainImg = document.getElementById('mainImage');

    if (mainImageContainer && mainImg) {
        mainImageContainer.addEventListener('mousemove', function (e) {
            const { left, top, width, height } = mainImageContainer.getBoundingClientRect();
            const x = e.clientX - left;
            const y = e.clientY - top;

            // Calculate percentage
            const xPercent = (x / width) * 100;
            const yPercent = (y / height) * 100;

            // Set transform origin
            mainImg.style.transformOrigin = `${xPercent}% ${yPercent}%`;
            mainImg.style.transform = "scale(2)"; // Zoom level
            mainImg.classList.add('zooming');
        });

        mainImageContainer.addEventListener('mouseleave', function () {
            mainImg.style.transformOrigin = "center center";
            mainImg.style.transform = "scale(1)";
            mainImg.classList.remove('zooming');
        });
    }
</script>
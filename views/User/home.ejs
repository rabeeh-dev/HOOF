<link rel="stylesheet" href="/user/css/home.css" />

<section class="section hero-home reveal" id="home">
  <div class="container hero-home-inner">
    <h1 class="hero-title">FIND YOUR PERFECT PAIR</h1>
    <p class="hero-subtitle">Premium sneakers for every style and stride</p>

    <div class="hero-search-minimal">
      <i class="fas fa-search search-icon"></i>
      <input type="text" placeholder="Search sneakers..." class="search-input-minimal" />
    </div>
  </div>
</section>

<section class="section products-section reveal" id="products">
  <div class="container">
    <div class="section-header">
      <p class="band-label">FEATURED</p>
      <h2>NEW ARRIVALS</h2>
      <p class="section-subtitle">Freshly dropped — shop the latest additions to our collection</p>
    </div>
    <div class="products-grid-home">
      <% if (typeof newArrivals !=='undefined' && newArrivals.length> 0) { %>
        <% newArrivals.forEach((product, index)=> { %>
          <div class="home-product-card" style="animation-delay: <%= index * 0.1 %>s">
            <div class="home-product-image" onclick="window.location.href='/user/product-details/<%= product._id %>'">
              <img src="<%= product.productImage[0] %>" alt="<%= product.productName %>" />
              <div class="home-card-overlay"></div>
              <span class="home-badge-new">NEW</span>
              <% if (product.salePrice < product.regularPrice) { %>
                <% const discount=Math.round(((product.regularPrice - product.salePrice) / product.regularPrice) * 100);
                  %>
                  <span class="home-badge-discount">-<%= discount %>%</span>
                  <% } %>
                    <div class="home-card-actions">
                      <button class="home-action-btn" onclick="event.stopPropagation(); addToCart('<%= product._id %>')"
                        title="Add to Bag">
                        <i class="fas fa-shopping-bag"></i>
                      </button>
                      <button class="home-action-btn" title="Wishlist">
                        <i class="far fa-heart"></i>
                      </button>
                    </div>
            </div>
            <div class="home-product-details">
              <span class="home-product-category">
                <%= product.category ? product.category.name : 'Sneakers' %>
              </span>
              <h3 class="home-product-name" onclick="window.location.href='/user/product-details/<%= product._id %>'">
                <%= product.productName %>
              </h3>
              <div class="home-product-pricing">
                <span class="home-current-price">₹<%= product.salePrice.toLocaleString('en-IN') %></span>
                <% if (product.salePrice < product.regularPrice) { %>
                  <span class="home-original-price">₹<%= product.regularPrice.toLocaleString('en-IN') %></span>
                  <% } %>
              </div>
            </div>
          </div>
          <% }) %>
            <% } else { %>
              <div class="home-empty-state">
                <i class="fas fa-box-open"></i>
                <p>No new arrivals at the moment.</p>
                <span>Check back soon for fresh drops!</span>
              </div>
              <% } %>
    </div>
    <div class="section-footer">
      <a href="/user/shop" class="btn outline view-all-btn">
        View All Products <i class="fas fa-arrow-right"></i>
      </a>
    </div>
  </div>
</section>

<section class="section categories-section reveal">
  <div class="container">
    <div class="section-header">
      <p class="band-label">CATEGORIES</p>
      <h2>SHOP BY STYLE</h2>
    </div>
    <div class="categories-grid">
      <div class="category-card">
        <div class="category-icon">
          <i class="fa-solid fa-shoe-prints"></i>
        </div>
        <h3>Sneakers</h3>
        <p>Performance gear</p>
      </div>
      <div class="category-card">
        <div class="category-icon"><i class="fas fa-street-view"></i></div>
        <h3>Loafers</h3>
        <p>Urban style</p>
      </div>
      <div class="category-card">
        <div class="category-icon">
          <i class="fa-solid fa-handshake"></i>
        </div>
        <h3>Derby</h3>
        <p>Everyday comfort</p>
      </div>
      <div class="category-card">
        <div class="category-icon">
          <i class="fa-solid fa-person-running"></i>
        </div>
        <h3>Running</h3>
        <p>Exclusive drops</p>
      </div>
      <div class="category-card">
        <div class="category-icon">
          <i class="fa-solid fa-user-tie"></i>
        </div>
        <h3>Formal</h3>
        <p>Urban style</p>
      </div>
      <div class="category-card">
        <div class="category-icon"><i class="fa-solid fa-bolt"></i></div>
        <h3>Chunky Snekears</h3>
        <p>Urban style</p>
      </div>
    </div>
  </div>
</section>

<script src="/user/js/home.js" defer></script>
<script>
  window.addEventListener("pageshow", function (event) {
    if (event.persisted || (typeof window.performance != "undefined" && window.performance.navigation.type === 2)) {
      window.location.reload();
    }
  });
</script>
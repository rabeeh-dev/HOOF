<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/admin/css/product-management.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="icon" type="image/x-icon" href="/user/images/home-images/favicon.ico">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

    <style>
        .error-msg {
            color: var(--admin-danger);
            font-size: 0.8rem;
            display: none;
            margin-top: 0.2rem;
        }

        .is-invalid {
            border-color: var(--admin-danger) !important;
        }
    </style>
</head>

<body>
    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo">HOOF</div>
            <p class="admin-label">Admin</p>
        </div>

        <nav class="sidebar-nav">
            <a href="/admin/dashboard" class="nav-item">
                <i class="fas fa-chart-line"></i>
                <span>Dashboard</span>
            </a>
            <a href="/admin/products" class="nav-item active">
                <i class="fas fa-box"></i>
                <span>Products</span>
            </a>
            <a href="/admin/categories" class="nav-item">
                <i class="fas fa-tags"></i>
                <span>Categories</span>
            </a>
            <a href="#" class="nav-item">
                <i class="fas fa-shopping-cart"></i>
                <span>Orders</span>
            </a>
            <a href="/admin/customers" class="nav-item">
                <i class="fas fa-users"></i>
                <span>Customers</span>
            </a>
            <a href="#" class="nav-item">
                <i class="fas fa-ticket-alt"></i>
                <span>Coupons</span>
            </a>
            <a href="#" class="nav-item">
                <i class="fas fa-chart-bar"></i>
                <span>Reports</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="admin-profile">
                <div class="admin-avatar">
                    <i class="fas fa-user"></i>
                </div>
                <div class="admin-info">
                    <h4>Admin User</h4>
                    <p>View Profile</p>
                </div>
                <button class="logout-btn" onclick="window.location.href='/admin/logout'" title="Logout">
                    <i class="fas fa-sign-out-alt"></i>
                </button>
            </div>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content">
        <header class="page-header">
            <div>
                <a href="/admin/products"
                    style="text-decoration: none; color: var(--admin-text-light); font-size: 0.9rem; margin-bottom: 0.5rem; display: block;">
                    <i class="fas fa-arrow-left"></i> Back to Products
                </a>
                <h1>Add New Product</h1>
            </div>
        </header>

        <form id="productForm" action="/admin/products/add" method="POST" enctype="multipart/form-data">
            <div class="form-grid">
                <!-- LEFT COLUMN: Basic Info & Branding -->
                <div class="form-section">
                    <div class="form-container">
                        <div class="form-section-title">General Information</div>
                        <div class="form-group">
                            <label for="productName">Product Name</label>
                            <input type="text" id="productName" name="productName" placeholder="e.g. Air Jordan 1 Retro"
                                required>
                            <small class="error-msg" id="nameError">Product name is required</small>
                        </div>
                        <div class="form-group">
                            <label for="description">Description</label>
                            <textarea id="description" name="description" placeholder="Enter product details..."
                                required></textarea>
                            <small class="error-msg" id="descError">Description is required</small>
                        </div>
                        <div class="form-grid" style="gap: 1rem;">
                            <div class="form-group">
                                <label for="category">Category</label>
                                <select id="category" name="category" required
                                    style="width: 100%; padding: 0.8rem; border-radius: 10px; border: 1px solid var(--admin-border);">
                                    <option value="">Select Category</option>
                                    <% categories.forEach(cat=> { %>
                                        <option value="<%= cat._id %>">
                                            <%= cat.name %>
                                        </option>
                                        <% }) %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="brand">Brand</label>
                                <input type="text" id="brand" name="brand" placeholder="e.g. Nike" required>
                                <small class="error-msg" id="brandError">Brand is required</small>
                            </div>
                        </div>
                    </div>

                    <div class="form-container" style="margin-top: 1.5rem;">
                        <div class="form-section-title">Pricing</div>
                        <div class="form-grid" style="gap: 1rem;">
                            <div class="form-group">
                                <label for="regularPrice">Regular Price (₹)</label>
                                <input type="number" id="regularPrice" name="regularPrice" placeholder="0.00" min="0"
                                    required>
                            </div>
                            <div class="form-group">
                                <label for="salePrice">Sale Price (₹)</label>
                                <input type="number" id="salePrice" name="salePrice" placeholder="0.00" min="0"
                                    required>
                                <small class="error-msg" id="priceError">Sale price cannot be higher than regular
                                    price</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- RIGHT COLUMN: Images & Variants -->
                <div class="form-section">
                    <div class="form-container">
                        <div class="form-section-title">Product Images</div>
                        <div class="image-upload-area" onclick="document.getElementById('imageFiles').click()">
                            <i class="fas fa-cloud-upload-alt"
                                style="font-size: 2rem; color: var(--admin-primary); margin-bottom: 0.5rem;"></i>
                            <p>Click to upload images</p>
                            <span style="font-size: 0.8rem; color: var(--admin-text-light);">JPG, PNG or WEBP (Max 4
                                images)</span>
                            <input type="file" id="imageFiles" name="productImages" multiple accept="image/*"
                                style="display: none;" onchange="previewImages(event)">
                        </div>
                        <div class="preview-container" id="imagePreview"></div>
                        <small class="error-msg" id="imageError">Please upload at least 1 image</small>
                    </div>

                    <div class="form-container" style="margin-top: 1.5rem;">
                        <div class="form-section-title">Stocks & Variants</div>
                        <div class="form-group">
                            <label for="totalStock">Total Base Stock</label>
                            <input type="number" id="totalStock" name="quantity" value="0" min="0">
                        </div>

                        <div
                            style="display: flex; justify-content: space-between; align-items: center; margin-top: 1rem;">
                            <h4 style="font-size: 0.9rem; font-weight: 600;">Manage Variants (Optional)</h4>
                            <button type="button" class="btn-add-variant" onclick="addVariantRow()">+ Add
                                Variant</button>
                        </div>

                        <table class="variants-table">
                            <thead>
                                <tr>
                                    <th>Size</th>
                                    <th>Color</th>
                                    <th>Stock</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="variantBody">
                                <!-- Dynamic Rows -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="form-actions" style="justify-content: flex-end; margin-top: 2rem;">
                <button type="button" class="btn-cancel" style="max-width: 150px;"
                    onclick="window.location.href='/admin/products'">Cancel</button>
                <button type="submit" class="btn-save" style="max-width: 200px;">Publish Product</button>
            </div>
        </form>
    </main>

<div id="cropperModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.9); z-index:9999; align-items:center; justify-content:center;">
    <div style="background: white; padding: 20px; border-radius: 10px; max-width: 90%; max-height: 90%; overflow: auto;">
        <div style="width: 500px; height: 500px; background: #eee;">
            <img id="imageToCrop" style="max-width: 100%;">
        </div>
        <div style="margin-top: 15px; display: flex; gap: 10px; justify-content: flex-end;">
            <button type="button" onclick="closeCropper()" class="btn-cancel" style="max-width: 100px;">Cancel</button>
            <button type="button" id="cropButton" class="btn-save" style="max-width: 100px;">Crop & Save</button>
        </div>
    </div>
</div>

<script>
    let cropper;
    let currentFiles = []; // Stores the final cropped blobs
    const imagePreview = document.getElementById('imagePreview');
    const cropperModal = document.getElementById('cropperModal');
    const imageToCrop = document.getElementById('imageToCrop');

    function previewImages(event) {
        const files = Array.from(event.target.files);
        if (currentFiles.length + files.length > 4) {
            Swal.fire('Limit exceeded', 'Maximum 4 images allowed', 'warning');
            return;
        }

        files.forEach(file => {
            const reader = new FileReader();
            reader.onload = (e) => {
                imageToCrop.src = e.target.result;
                cropperModal.style.display = 'flex';
                if (cropper) cropper.destroy();
                cropper = new Cropper(imageToCrop, {
                    aspectRatio: 1, // Perfect square for sneakers
                    viewMode: 1
                });

                document.getElementById('cropButton').onclick = () => {
                    const canvas = cropper.getCroppedCanvas({ width: 800, height: 800 });
                    canvas.toBlob((blob) => {
                        const croppedFile = new File([blob], file.name, { type: 'image/jpeg' });
                        currentFiles.push(croppedFile);
                        displayPreview(croppedFile);
                        closeCropper();
                    }, 'image/jpeg');
                };
            };
            reader.readAsDataURL(file);
        });
    }

    function displayPreview(file) {
        const reader = new FileReader();
        reader.onload = (e) => {
            const div = document.createElement('div');
            div.className = 'preview-item';
            div.innerHTML = `
                <img src="${e.target.result}">
                <span class="remove-img" onclick="removeImage(${currentFiles.length - 1})">&times;</span>
            `;
            imagePreview.appendChild(div);
        };
        reader.readAsDataURL(file);
    }

    function closeCropper() {
        cropperModal.style.display = 'none';
        if (cropper) cropper.destroy();
    }

    function removeImage(index) {
        currentFiles.splice(index, 1);
        imagePreview.innerHTML = '';
        currentFiles.forEach(file => displayPreview(file));
    }

    // FORM SUBMISSION (Using AJAX to send Blobs)
    document.getElementById('productForm').onsubmit = async (e) => {
        e.preventDefault();
        
        const formData = new FormData(e.target);
        // Remove the original file input data and append cropped files
        formData.delete('productImages');
        currentFiles.forEach(file => {
            formData.append('productImages', file);
        });

        try {
            const response = await fetch('/admin/products/add', {
                method: 'POST',
                body: formData
            });
            const result = await response.json();
            if (result.success) {
                Swal.fire('Success', 'Product published!', 'success').then(() => {
                    window.location.href = '/admin/products';
                });
            } else {
                Swal.fire('Error', result.message, 'error');
            }
        } catch (err) {
            Swal.fire('Error', 'Server communication failed', 'error');
        }
    };
</script>
</body>

</html>
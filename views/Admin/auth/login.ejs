<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Portal | HOOF</title>
  <link rel="stylesheet" href="/admin/css/login.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="icon" type="image/x-icon" href="/user/images/home-images/favicon.ico">
</head>

<body>
  <div class="admin-login-container">
    <div class="admin-login-card">
      <!-- Shield Icon -->
      <div class="admin-shield-icon">
        <i class="fas fa-shield-halved"></i>
      </div>

      <!-- Header -->
      <div class="admin-header">
        <h1>ADMIN PORTAL</h1>
        <p>Secure access for authorized personnel only</p>
      </div>

      <!-- Login Form -->
      <form class="admin-login-form" id="adminLoginForm" action="/admin/login" method="POST">
        <div class="admin-form-group">
          <label for="adminEmail">Email Address</label>
          <input type="email" id="adminEmail" name="email" placeholder="admin@company.com" required />
        </div>

        <div class="admin-form-group">
          <label for="adminPassword">Password</label>
          <div class="password-wrapper">
            <input type="password" id="adminPassword" name="password" placeholder="••••••••" required />
            <button type="button" class="toggle-password" id="togglePassword">
              <i class="fas fa-eye"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="admin-signin-btn">
          <span>Sign In</span>
          <i class="fas fa-arrow-right"></i>
        </button>
      </form>

      <!-- Footer Notes -->
      <div class="admin-footer-notes">
        <p>Protected by enterprise-grade security.</p>
        <p>IP Address logged for security purposes.</p>
      </div>
    </div>

    <!-- Bottom Links -->
    <div class="admin-bottom-links">
      <a href="#">Help Center</a>
      <a href="#">Privacy Policy</a>
      <a href="#">Contact Support</a>
    </div>
  </div>

  <script src="/admin/js/login.js" defer></script>
</body>

</html>
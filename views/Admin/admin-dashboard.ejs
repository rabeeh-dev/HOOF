<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard Overview | HOOF Admin</title>
  <link rel="stylesheet" href="/admin/css/admin-dashboard.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="icon" type="image/x-icon" href="/user/images/home-images/favicon.ico">
</head>
<body>
  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-header">
      <div class="logo">HOOF</div>
      <p class="admin-label">Admin</p>
    </div>

    <nav class="sidebar-nav">
      <a href="#" class="nav-item active">
        <i class="fas fa-chart-line"></i>
        <span>Dashboard</span>
      </a>
      <a href="#" class="nav-item">
        <i class="fas fa-box"></i>
        <span>Products</span>
      </a>
      <a href="#" class="nav-item">
        <i class="fas fa-shopping-cart"></i>
        <span>Orders</span>
      </a>
      <a href="/admin/customers" class="nav-item">
        <i class="fas fa-users"></i>
        <span>Customers</span>
      </a>
      <a href="#" class="nav-item">
        <i class="fas fa-ticket-alt"></i>
        <span>Coupons</span>
      </a>
      <a href="#" class="nav-item">
        <i class="fas fa-chart-bar"></i>
        <span>Reports</span>
      </a>
    </nav>

    <div class="sidebar-footer">
      <div class="admin-profile">
        <div class="admin-avatar">
          <i class="fas fa-user"></i>
        </div>
        <div class="admin-info">
          <h4>Admin User</h4>
          <p>View Profile</p>
        </div>
        <button class="logout-btn">
          <i class="fas fa-sign-out-alt"></i>
        </button>
      </div>
    </div>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">
    <!-- HEADER -->
    <header class="dashboard-header">
      <div>
        <h1>Dashboard Overview</h1>
      </div>
      <div class="header-actions">
        <select class="date-filter">
          <option>Last 7 Days</option>
          <option>Last 30 Days</option>
          <option>Last 90 Days</option>
          <option>This Year</option>
        </select>
        <button class="btn-download">
          <i class="fas fa-download"></i>
          Download Report
        </button>
      </div>
    </header>

    <!-- STATS CARDS -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon revenue">
          <i class="fas fa-dollar-sign"></i>
        </div>
        <div class="stat-content">
          <p class="stat-label">Total Revenue</p>
          <h3 class="stat-value">$45,231.89</h3>
          <span class="stat-change positive">
            <i class="fas fa-arrow-up"></i> +20.1%
          </span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon orders">
          <i class="fas fa-shopping-bag"></i>
        </div>
        <div class="stat-content">
          <p class="stat-label">Total Orders</p>
          <h3 class="stat-value">2,345</h3>
          <span class="stat-change positive">
            <i class="fas fa-arrow-up"></i> +15.2%
          </span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon customers">
          <i class="fas fa-users"></i>
        </div>
        <div class="stat-content">
          <p class="stat-label">Total Customers</p>
          <h3 class="stat-value">1,234</h3>
          <span class="stat-change positive">
            <i class="fas fa-arrow-up"></i> +10.5%
          </span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon products">
          <i class="fas fa-box-open"></i>
        </div>
        <div class="stat-content">
          <p class="stat-label">Products</p>
          <h3 class="stat-value">432</h3>
          <span class="stat-change positive">
            <i class="fas fa-arrow-up"></i> +12.5%
          </span>
        </div>
      </div>
    </div>

    <!-- CONTENT GRID -->
    <div class="content-grid">
      <!-- SALES OVERVIEW -->
      <div class="card sales-overview">
        <div class="card-header">
          <h3>Sales Overview</h3>
        </div>
        <div class="card-body">
          <div class="chart-placeholder">
            <i class="fas fa-chart-area"></i>
            <p>Sales chart visualization would go here</p>
            <small>(In the real app, use Chart.js or similar)</small>
          </div>
        </div>
      </div>

      <!-- LOW STOCK ALERTS -->
      <div class="card low-stock">
        <div class="card-header">
          <h3>Low Stock Alerts</h3>
          <a href="#" class="view-all">View All</a>
        </div>
        <div class="card-body">
          <div class="stock-item">
            <div class="stock-info">
              <h4>Nike Air Force 1</h4>
              <p>Size: US 9</p>
            </div>
            <span class="stock-badge critical">2 left</span>
          </div>
          <div class="stock-item">
            <div class="stock-info">
              <h4>Adidas Stan Smith</h4>
              <p>Size: US 10</p>
            </div>
            <span class="stock-badge warning">5 left</span>
          </div>
          <div class="stock-item">
            <div class="stock-info">
              <h4>Vans Old Skool</h4>
              <p>Size: US 8</p>
            </div>
            <span class="stock-badge warning">3 left</span>
          </div>
        </div>
      </div>
    </div>

    <!-- RECENT ORDERS -->
    <div class="card recent-orders">
      <div class="card-header">
        <h3>Recent Orders</h3>
        <a href="#" class="view-all">
          View All Orders
          <i class="fas fa-arrow-right"></i>
        </a>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="orders-table">
            <thead>
              <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Product</th>
                <th>Amount</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><span class="order-id">#ORD-7352</span></td>
                <td>Alex Johnson</td>
                <td>Nike Air Max 90</td>
                <td>$129.00</td>
                <td><span class="status-badge delivered">Delivered</span></td>
              </tr>
              <tr>
                <td><span class="order-id">#ORD-7351</span></td>
                <td>Sarah Smith</td>
                <td>Adidas Ultraboost</td>
                <td>$180.00</td>
                <td><span class="status-badge processing">Processing</span></td>
              </tr>
              <tr>
                <td><span class="order-id">#ORD-7350</span></td>
                <td>Michael Brown</td>
                <td>Puma RS-X</td>
                <td>$110.00</td>
                <td><span class="status-badge shipped">Shipped</span></td>
              </tr>
              <tr>
                <td><span class="order-id">#ORD-7349</span></td>
                <td>Emily Davis</td>
                <td>New Balance 574</td>
                <td>$85.00</td>
                <td><span class="status-badge pending">Pending</span></td>
              </tr>
              <tr>
                <td><span class="order-id">#ORD-7348</span></td>
                <td>James Wilson</td>
                <td>Converse Chuck 70</td>
                <td>$90.00</td>
                <td><span class="status-badge delivered">Delivered</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>

  <script src="/admin/js/admin-dashboard.js" defer></script>
</body>
</html>
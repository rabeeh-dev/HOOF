<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard Overview | HOOF Admin</title>
  <link rel="stylesheet" href="/admin/css/admin-dashboard.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="icon" type="image/x-icon" href="/user/images/home-images/favicon.ico">
</head>

<body>
  <%- include('../partials/admin/overlay') %>
    <!-- SIDEBAR -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="logo">HOOF</div>
        <p class="admin-label">Admin</p>
      </div>

      <nav class="sidebar-nav">
        <a href="#" class="nav-item active">
          <i class="fas fa-chart-line"></i>
          <span>Dashboard</span>
        </a>
        <a href="/admin/products" class="nav-item">
          <i class="fas fa-box"></i>
          <span>Products</span>
        </a>
        <a href="/admin/categories" class="nav-item">
          <i class="fas fa-tags"></i>
          <span>Categories</span>
        </a>
        <a href="/admin/orders" class="nav-item">
          <i class="fas fa-shopping-cart"></i>
          <span>Orders</span>
        </a>
        <a href="/admin/customers" class="nav-item">
          <i class="fas fa-users"></i>
          <span>Customers</span>
        </a>
        <a href="/admin/coupons" class="nav-item">
          <i class="fas fa-ticket-alt"></i>
          <span>Coupons</span>
        </a>
      </nav>

      <div class="sidebar-footer">
        <div class="admin-profile">
          <div class="admin-avatar">
            <i class="fas fa-user"></i>
          </div>
          <div class="admin-info">
            <h4>Admin User</h4>
            <p>View Profile</p>
          </div>
          <button class="logout-btn">
            <i class="fas fa-sign-out-alt"></i>
          </button>
        </div>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content">
      <!-- HEADER -->
      <header class="dashboard-header">
        <div class="header-main">
          <h1>Dashboard Overview</h1>
          <p class="header-subtitle">Welcome back — here's what's happening with your store.</p>
        </div>

        <div class="header-actions">
          <div class="filter-controls">
            <label for="dashboardFilter" class="filter-label">Filter:</label>
            <div class="custom-dates" id="customDateRange" style="display: none;">
              <input type="date" id="startDate" class="date-input" value="<%= query.startDate || '' %>">
              <input type="date" id="endDate" class="date-input" value="<%= query.endDate || '' %>">
            </div>

            <select id="dashboardFilter" class="filter-select">
              <option value="daily" <%=activeFilter==='daily' ? 'selected' : '' %>>Today</option>
              <option value="weekly" <%=activeFilter==='weekly' ? 'selected' : '' %>>Last 7 Days</option>
              <option value="yearly" <%=activeFilter==='yearly' ? 'selected' : '' %>>Yearly</option>
              <option value="custom" <%=activeFilter==='custom' ? 'selected' : '' %>>Custom Range</option>
            </select>

            <button id="applyFilter" class="btn-apply" style="display: none;">Apply</button>
          </div>

          <div class="report-actions">
            <button class="btn-report btn-pdf" id="downloadPDF" title="Export Report">
              <i class="fas fa-file-pdf"></i>
              <span>Export</span>
            </button>
          </div>
        </div>
      </header>

      <!-- STATS CARDS -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon revenue">
            <i class="fas fa-indian-rupee-sign"></i>
          </div>
          <div class="stat-content">
            <p class="stat-label">Total Revenue</p>
            <h3 class="stat-value" id="statRevenue" data-value="<%= stats.totalRevenue %>">₹<%=
                stats.totalRevenue.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
            </h3>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon orders">
            <i class="fas fa-shopping-bag"></i>
          </div>
          <div class="stat-content">
            <p class="stat-label">Total Orders</p>
            <h3 class="stat-value" id="statOrders" data-value="<%= stats.totalOrders %>">
              <%= stats.totalOrders.toLocaleString() %>
            </h3>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon customers">
            <i class="fas fa-users"></i>
          </div>
          <div class="stat-content">
            <p class="stat-label">Total Customers</p>
            <h3 class="stat-value" id="statCustomers" data-value="<%= stats.totalCustomers %>">
              <%= stats.totalCustomers.toLocaleString() %>
            </h3>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon products">
            <i class="fas fa-box-open"></i>
          </div>
          <div class="stat-content">
            <p class="stat-label">Active Products</p>
            <h3 class="stat-value" id="statProducts" data-value="<%= stats.totalProducts %>">
              <%= stats.totalProducts.toLocaleString() %>
            </h3>
          </div>
        </div>
      </div>

      <!-- CHARTS ROW -->
      <div class="charts-grid-full">
        <!-- SALES OVERVIEW CHART -->
        <div class="card chart-card sales-chart-card">
          <div class="card-header">
            <h3><i class="fas fa-chart-area chart-icon"></i> Sales Overview</h3>
            <span class="chart-subtitle">Monthly revenue (last 12 months)</span>
          </div>
          <div class="card-body">
            <canvas id="salesChart"></canvas>
          </div>
        </div>
      </div>

      <!-- TOP SELLING PRODUCTS & LOW STOCK -->
      <div class="charts-grid">
        <!-- TOP SELLING PRODUCTS -->
        <div class="card chart-card top-products-card">
          <div class="card-header">
            <h3><i class="fas fa-fire chart-icon"></i> Top Selling Products</h3>
          </div>
          <div class="card-body">
            <% if (topProducts && topProducts.length> 0) { %>
              <div class="top-products-list">
                <% topProducts.forEach((product, index)=> { %>
                  <div class="top-product-item">
                    <div class="top-product-rank">
                      <%= index + 1 %>
                    </div>
                    <div class="top-product-image">
                      <% if (product.image) { %>
                        <img src="<%= product.image %>" alt="<%= product.name %>" />
                        <% } else { %>
                          <div class="product-image-placeholder"><i class="fas fa-shoe-prints"></i></div>
                          <% } %>
                    </div>
                    <div class="top-product-info">
                      <h4>
                        <%= product.name || 'Unknown Product' %>
                      </h4>
                      <p>
                        <%= product.totalSold %> sold · ₹<%= product.totalRevenue.toLocaleString('en-IN') %>
                      </p>
                    </div>
                  </div>
                  <% }); %>
              </div>
              <% } else { %>
                <div class="empty-state">
                  <i class="fas fa-box-open"></i>
                  <p>No sales data available yet</p>
                </div>
                <% } %>
          </div>
        </div>

        <!-- LOW STOCK ALERTS -->
        <div class="card low-stock">
          <div class="card-header">
            <h3><i class="fas fa-exclamation-triangle chart-icon warning-icon"></i> Low Stock Alerts</h3>
            <a href="/admin/products" class="view-all">View All</a>
          </div>
          <div class="card-body">
            <% if (lowStockProducts && lowStockProducts.length> 0) { %>
              <% lowStockProducts.forEach(item=> { %>
                <div class="stock-item">
                  <div class="stock-info">
                    <h4>
                      <%= item.productName %>
                    </h4>
                    <p>Size: <%= item.variantSize %>
                    </p>
                  </div>
                  <span class="stock-badge <%= item.variantQty <= 2 ? 'critical' : 'warning' %>">
                    <%= item.variantQty %> left
                  </span>
                </div>
                <% }); %>
                  <% } else { %>
                    <div class="empty-state">
                      <i class="fas fa-check-circle"></i>
                      <p>All products are well stocked</p>
                    </div>
                    <% } %>
          </div>
        </div>
      </div>

      <!-- RECENT ORDERS -->
      <div class="charts-grid-full">
        <div class="card recent-orders">
          <div class="card-header">
            <h3><i class="fas fa-clock chart-icon"></i> Recent Orders</h3>
            <a href="/admin/orders" class="view-all">
              View All Orders
              <i class="fas fa-arrow-right"></i>
            </a>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="orders-table">
                <thead>
                  <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Product</th>
                    <th>Amount</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (recentOrders && recentOrders.length> 0) { %>
                    <% recentOrders.forEach(order=> { %>
                      <tr>
                        <td><span class="order-id">#<%= order._id.toString().slice(-6).toUpperCase() %></span></td>
                        <td>
                          <%= order.userId ? order.userId.fullName : 'N/A' %>
                        </td>
                        <td>
                          <%= order.items && order.items[0] ? order.items[0].productName : 'N/A' %>
                            <% if (order.items && order.items.length> 1) { %> <span class="more-items">+<%=
                                  order.items.length - 1 %></span>
                              <% } %>
                        </td>
                        <td>₹<%= order.totalAmount ? order.totalAmount.toLocaleString('en-IN') : '0' %>
                        </td>
                        <td>
                          <% 
                            const itemStatuses = {};
                            const oStatus = (order.status || '').toLowerCase();
                            const oWasDelivered = ['delivered', 'returned', 'return requested', 'return approved', 'picked up', 'partially refunded'].includes(oStatus);
                            
                            if (order.items && order.items.length > 0) {
                                order.items.forEach(item => {
                                    const rawStat = item.itemStatus || 'Active';
                                    let dispStat = (rawStat === 'Active' && oWasDelivered) ? 'Delivered' : rawStat;
                                    if (rawStat === 'Active' && !oWasDelivered && ['pending', 'processing', 'shipped', 'out for delivery'].includes(oStatus)) {
                                        dispStat = order.status;
                                    } else if (rawStat === 'Active' && oStatus === 'cancelled') {
                                        dispStat = 'Cancelled';
                                    }
                                    itemStatuses[dispStat] = (itemStatuses[dispStat] || 0) + 1;
                                });
                            } else {
                                itemStatuses[order.status] = 1;
                            }
                          %>
                          <div style="display: flex; flex-direction: column; gap: 4px;">
                              <% for (const [stat, count] of Object.entries(itemStatuses)) { %>
                                  <span class="status-badge <%= stat ? stat.toLowerCase().replace(/\s+/g, '-') : '' %>" style="font-size: 0.75rem; padding: 0.2rem 0.6rem; width: fit-content; display: inline-block;">
                                      <%= count %> <%= stat %>
                                  </span>
                              <% } %>
                          </div>
                        </td>
                      </tr>
                      <% }); %>
                        <% } else { %>
                          <tr>
                            <td colspan="5" class="empty-table">No orders yet</td>
                          </tr>
                          <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Pass server data to JS -->
    <script>
      console.log("Initializing Dashboard Data...");
      window.__dashboardData = {
        monthlySales: <% - JSON.stringify(monthlySales || []) %>,
        statusBreakdown: <% - JSON.stringify(statusBreakdown || {}) %>,
        categorySales: <% - JSON.stringify(categorySales || []) %>
      };
      console.log("Dashboard Data Initialized:", window.__dashboardData);
    </script>

    <%- include('../partials/admin/overlay-scripts') %>
      <script src="/admin/js/admin-dashboard.js?v=<%= Date.now() %>" defer></script>
      <script>
        window.addEventListener("pageshow", function (event) {
          const navEntries = performance.getEntriesByType('navigation');
          const isBackForward = navEntries.length > 0 && navEntries[0].type === 'back_forward';

          if (event.persisted || isBackForward) {
            window.location.reload();
          }
        });
      </script>

</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/admin/css/admin-dashboard.css" />
    <link rel="stylesheet" href="/admin/css/coupons.css" />
    <!-- Adding standard admin management CSS for consistent classes -->
    <link rel="stylesheet" href="/admin/css/category-management.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;&display=swap"
        rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="icon" type="image/x-icon" href="/user/images/home-images/favicon.ico">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
    <%- include('../partials/admin/overlay') %>
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="logo">HOOF</div>
                <p class="admin-label">Admin</p>
            </div>

            <nav class="sidebar-nav">
                <a href="/admin/dashboard" class="nav-item">
                    <i class="fas fa-chart-line"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/admin/products" class="nav-item">
                    <i class="fas fa-box"></i>
                    <span>Products</span>
                </a>
                <a href="/admin/categories" class="nav-item">
                    <i class="fas fa-tags"></i>
                    <span>Categories</span>
                </a>
                <a href="/admin/orders" class="nav-item">
                    <i class="fas fa-shopping-cart"></i>
                    <span>Orders</span>
                </a>
                <a href="/admin/customers" class="nav-item">
                    <i class="fas fa-users"></i>
                    <span>Customers</span>
                </a>
                <a href="/admin/coupons" class="nav-item active">
                    <i class="fas fa-ticket-alt"></i>
                    <span>Coupons</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="admin-profile">
                    <div class="admin-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="admin-info">
                        <h4>Admin User</h4>
                        <p>View Profile</p>
                    </div>
                    <button class="logout-btn" onclick="window.location.href='/admin/logout'">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </div>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            <header class="page-header">
                <div>
                    <h1>Coupon Management</h1>
                </div>
                <div class="header-actions">
                    <button class="btn-add" onclick="openAddCouponModal()">
                        <i class="fas fa-plus"></i>
                        Add Coupon
                    </button>
                </div>
            </header>

            <!-- STATS STRIP (Standard Admin Style) -->
            <div class="stats-strip" style="display: flex; gap: 1.5rem; margin-bottom: 2rem;">
                <div class="stat-card"
                    style="flex: 1; background: white; padding: 1.5rem; border-radius: 12px; border: 1px solid var(--admin-border); display: flex; align-items: center; gap: 1rem;">
                    <div class="stat-icon"
                        style="width: 48px; height: 48px; border-radius: 10px; display: flex; align-items: center; justify-content: center; background: rgba(196, 30, 58, 0.1); color: var(--admin-primary);">
                        <i class="fas fa-ticket-alt" style="font-size: 1.2rem;"></i>
                    </div>
                    <div>
                        <div style="font-size: 1.5rem; font-weight: 700; color: var(--admin-text);">
                            <%= coupons.length %>
                        </div>
                        <div style="font-size: 0.85rem; color: var(--admin-text-light);">Total Coupons</div>
                    </div>
                </div>
                <div class="stat-card"
                    style="flex: 1; background: white; padding: 1.5rem; border-radius: 12px; border: 1px solid var(--admin-border); display: flex; align-items: center; gap: 1rem;">
                    <div class="stat-icon"
                        style="width: 48px; height: 48px; border-radius: 10px; display: flex; align-items: center; justify-content: center; background: rgba(39, 174, 96, 0.1); color: #27ae60;">
                        <i class="fas fa-check-circle" style="font-size: 1.2rem;"></i>
                    </div>
                    <div>
                        <div style="font-size: 1.5rem; font-weight: 700; color: var(--admin-text);">
                            <%= coupons.filter(c=> !c.isBlocked && new Date(c.expiryDate) > new Date()).length %>
                        </div>
                        <div style="font-size: 0.85rem; color: var(--admin-text-light);">Active</div>
                    </div>
                </div>
                <div class="stat-card"
                    style="flex: 1; background: white; padding: 1.5rem; border-radius: 12px; border: 1px solid var(--admin-border); display: flex; align-items: center; gap: 1rem;">
                    <div class="stat-icon"
                        style="width: 48px; height: 48px; border-radius: 10px; display: flex; align-items: center; justify-content: center; background: rgba(231, 76, 60, 0.1); color: #e74c3c;">
                        <i class="fas fa-clock" style="font-size: 1.2rem;"></i>
                    </div>
                    <div>
                        <div style="font-size: 1.5rem; font-weight: 700; color: var(--admin-text);">
                            <%= coupons.filter(c=> new Date(c.expiryDate) <= new Date()).length %>
                        </div>
                        <div style="font-size: 0.85rem; color: var(--admin-text-light);">Expired</div>
                    </div>
                </div>
            </div>

            <div class="categories-card">
                <div class="search-bar">
                    <i class="fas fa-search"></i>
                    <input type="text" id="couponSearch" placeholder="Search by code or description..."
                        onkeyup="searchCoupons()">
                </div>
                <div class="table-container">
                    <table class="categories-table">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Description</th>
                                <th>Discount</th>
                                <th>Min. Purchase</th>
                                <th>Expiry Date</th>
                                <th>Usage</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="couponTableBody">
                            <% if (coupons && coupons.length> 0) { %>
                                <% coupons.forEach(coupon=> { %>
                                    <% const isExpired=new Date(coupon.expiryDate) <=new Date(); const
                                        statusClass=coupon.isBlocked ? 'unlisted' : (isExpired ? 'expired' : 'listed' );
                                        const statusLabel=coupon.isBlocked ? 'Blocked' : (isExpired ? 'Expired'
                                        : 'Active' ); %>
                                        <tr>
                                            <td><span class="coupon-code-cell"
                                                    style="font-family: monospace; font-weight: 700; color: var(--admin-primary); background: rgba(196, 30, 58, 0.05); padding: 0.3rem 0.6rem; border-radius: 4px;">
                                                    <%= coupon.couponCode %>
                                                </span></td>
                                            <td>
                                                <h4 class="category-name">
                                                    <%= coupon.description %>
                                                </h4>
                                            </td>
                                            <td>
                                                <span class="discount-badge" style="font-weight: 600; color: #3498db;">
                                                    <%= coupon.discountType==='percentage' ? coupon.discountValue + '%'
                                                        : '₹' + coupon.discountValue %>
                                                </span>
                                            </td>
                                            <td>₹<%= coupon.minPurchaseAmount %>
                                            </td>
                                            <td>
                                                <%= new Date(coupon.expiryDate).toLocaleDateString() %>
                                            </td>
                                            <td>
                                                <div style="font-size: 0.85rem;">
                                                    <span style="font-weight: 600;">
                                                        <%= coupon.usedCount %>
                                                    </span> / <%= coupon.usageLimit %>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="status-badge <%= statusClass %>">
                                                    <%= statusLabel %>
                                                </span>
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    <button class="action-btn edit"
                                                        onclick="openEditCouponModal('<%= coupon._id %>')" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button
                                                        class="action-btn toggle <%= coupon.isBlocked ? 'list' : 'unlist' %>"
                                                        onclick="toggleCouponStatus('<%= coupon._id %>')"
                                                        title="<%= coupon.isBlocked ? 'Unblock' : 'Block' %>">
                                                        <i
                                                            class="fas <%= coupon.isBlocked ? 'fa-eye' : 'fa-eye-slash' %>"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="8"
                                                        style="text-align: center; padding: 3rem; color: var(--admin-text-light);">
                                                        <i class="fas fa-ticket-alt"
                                                            style="font-size: 2rem; display: block; margin-bottom: 1rem; opacity: 0.3;"></i>
                                                        No coupons found. Click "Add Coupon" to get started.
                                                    </td>
                                                </tr>
                                                <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>

        <!-- Coupon Modal -->
        <div id="couponModal" class="modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 id="modalTitle">Create New Coupon</h2>
                    <span class="close-modal" onclick="closeCouponModal()">&times;</span>
                </div>
                <form id="couponForm" onsubmit="submitCouponForm(event)">
                    <input type="hidden" id="couponId" name="couponId">
                    <div class="form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem;">
                        <div class="form-group">
                            <label for="couponCode">Coupon Code</label>
                            <input type="text" id="couponCode" name="couponCode" placeholder="e.g. SAVE20" required>
                        </div>
                        <div class="form-group">
                            <label for="discountType">Discount Type</label>
                            <select id="discountType" name="discountType"
                                style="width:100%; padding:0.8rem; border:1px solid var(--admin-border); border-radius:10px; outline:none;">
                                <option value="percentage">Percentage (%)</option>
                                <option value="fixed">Fixed Amount (₹)</option>
                            </select>
                        </div>
                        <div class="form-group" style="grid-column: span 2;">
                            <label for="description">Description</label>
                            <input type="text" id="description" name="description"
                                placeholder="e.g. 20% off on your next purchase" required>
                        </div>
                        <div class="form-group">
                            <label for="discountValue">Discount Value</label>
                            <input type="number" id="discountValue" name="discountValue" min="0" required>
                        </div>
                        <div class="form-group">
                            <label for="minPurchaseAmount">Min. Purchase (₹)</label>
                            <input type="number" id="minPurchaseAmount" name="minPurchaseAmount" min="0" value="0" required>
                        </div>
                        <div class="form-group" id="maxDiscountGroup">
                            <label for="maxDiscountAmount">Max Discount (₹)</label>
                            <input type="number" id="maxDiscountAmount" name="maxDiscountAmount" min="0" placeholder="Required for %">
                        </div>
                        <div class="form-group">
                            <label for="expiryDate">Expiry Date</label>
                            <input type="date" id="expiryDate" name="expiryDate" required>
                        </div>
                        <div class="form-group" style="grid-column: span 2;">
                            <label for="usageLimit">Usage Limit (Total)</label>
                            <input type="number" id="usageLimit" name="usageLimit" min="1" value="1" required>
                        </div>
                    </div>
                    <div class="form-actions" style="display: flex; gap: 1rem; margin-top: 2rem;">
                        <button type="button" class="btn-cancel" onclick="closeCouponModal()">Cancel</button>
                        <button type="submit" class="btn-save">Save Coupon</button>
                    </div>
                </form>
            </div>
        </div>

        <%- include('../partials/admin/overlay-scripts') %>
            <script src="/admin/js/coupons.js"></script>
</body>

</html>
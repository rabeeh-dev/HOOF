{
  "name": "hoof-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "HOOF E-Commerce platform - Monorepo workspace containing client and server",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "server:dev": "npm --prefix server run start",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:preview": "npm --prefix client run preview",
    "server:install": "npm --prefix server install",
    "client:install": "npm --prefix client install",
    "install:all": "npm run server:install && npm run client:install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}

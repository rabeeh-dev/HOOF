<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/user/head') %>
        <title>
            <%= locals.title || 'HOOF' %>
        </title>

        <link rel="stylesheet" href="/user/css/layout.css">
        <link rel="stylesheet" href="/user/css/breadcrumb.css">
        <%- style %>
        <%- meta %>
        <meta name="user-id" content="<%= locals.user ? locals.user.id : '' %>">
</head>

<body>
    <!-- Global Loading Overlay -->
    <div id="global-loading-overlay" class="loading-overlay" style="display: none;">
        <div class="overlay-content">
            <div class="spinner-container">
                <div class="spinner-main"></div>
                <div class="spinner-ring"></div>
            </div>
            <p class="loading-text">Processing your request...</p>
        </div>
    </div>
    <%- include('../partials/user/header') %>

        <% if (locals.breadcrumbs && locals.breadcrumbs.length> 0) { %>
            <div class="breadcrumb-container">
                <div class="container">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <% breadcrumbs.forEach((crumb, index)=> { %>
                                <% if (index===breadcrumbs.length - 1) { %>
                                    <li class="breadcrumb-item active" aria-current="page">
                                        <%= crumb.name %>
                                    </li>
                                    <% } else { %>
                                        <li class="breadcrumb-item"><a href="<%= crumb.url %>">
                                                <%= crumb.name %>
                                            </a></li>
                                        <% } %>
                                            <% }); %>
                        </ol>
                    </nav>
                </div>
            </div>
            <% } %>

                <main>
                    <%- body %>
                </main>

                <%- include('../partials/user/footer') %>

                    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
                    <script src="/socket.io/socket.io.js"></script>
                    <script src="/user/js/layout.js" defer></script>
                    <%- script %>
</body>

</html>
<% locals.showBackButton=true %>
  <link rel="stylesheet" href="/user/css/verify-otp.css" />

  <section class="section otp-hero reveal">
    <div class="container">
      <div class="otp-container">
        <div class="otp-card">
          <div class="otp-header">
            <div class="otp-icon">
              <i class="fas fa-shield-check"></i>
            </div>
            <h1 class="otp-title">Verify Your Email</h1>
            <p class="otp-subtitle">Enter the 6-digit code sent to your email</p>
          </div>

          <form class="otp-form" id="otpForm" action="/user/verify-otp" method="POST">
            <div class="otp-inputs">
              <div class="otp-input-group">
                <input type="text" class="otp-input" maxlength="1" data-index="0" required />
              </div>
              <div class="otp-input-group">
                <input type="text" class="otp-input" maxlength="1" data-index="1" required />
              </div>
              <div class="otp-input-group">
                <input type="text" class="otp-input" maxlength="1" data-index="2" required />
              </div>
              <div class="otp-input-group">
                <input type="text" class="otp-input" maxlength="1" data-index="3" required />
              </div>
              <div class="otp-input-group">
                <input type="text" class="otp-input" maxlength="1" data-index="4" required />
              </div>
              <div class="otp-input-group">
                <input type="text" class="otp-input" maxlength="1" data-index="5" required />
              </div>
            </div>

            <input type="hidden" name="otp" id="otpHidden" />

            <div class="otp-timer">
              <span id="timer">02:00</span>
              <button type="button" class="resend-otp" id="resendOtp">Resend Code</button>
            </div>

            <button type="submit" class="btn primary otp-btn">Verify OTP</button>
          </form>

          <div class="otp-divider">
            <span>or</span>
          </div>

          <button type="button" class="btn google-signup">
            <i class="fab fa-google"></i> Continue with Google
          </button>

          <div class="otp-footer">
            <p>Didn't receive code? <a href="#" id="contactSupport">Contact Support</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script src="/user/js/verify-otp.js" defer></script>
<link rel="stylesheet" href="/user/css/landing.css" />

<!-- HERO SECTION -->
<!-- HERO SECTION -->
<section class="section hero" id="home">
  <div class="container hero-inner">
    <div class="hero-left">
      <p class="welcome">WELCOME TO HOOF</p>
      <h1>FIND YOUR<br /><span>PERFECT PAIR</span></h1>
      <p class="hero-sub">
        Premium sneakers for every style and stride.
      </p>
      
    </div>

    <div class="hero-right">
      <div class="hero-shoe-card floating">
        <img src="/user/images/Homeshoe.png" alt="Sneaker main" />
      </div>
      <div class="hero-badge">
        <div class="badge-number">2000+</div>
        <p class="badge-text">Happy customers</p>
        <button class="badge-btn"><a href="/user/signup" style="color: rgb(213, 0, 0)">Sign Up</a></button>
      </div>
    </div>
  </div>
</section>

<!-- VISION / MISSION SECTION -->
<section class="section band about-band" id="about">
  <div class="container about-inner">
    <div class="about-image">
      <img src="/user/images/shoe3.jpg" alt="Sneaker portrait" />
    </div>
    <div class="about-text">
      <p class="band-label">QUALITY YOU CAN FEEL IN EVERY STEP</p>

      <div class="about-block">
        <h3>Our Vision</h3>
        <p>
          We craft sneakers that fuse modern aesthetics with all-day
          comfort, giving you confidence in every step you take.
        </p>
      </div>
      <br />
      <button class="btn light">Read more</button>
      <hr />

      <div class="about-block">
        <h3>Our Mission</h3>
        <p>
          To deliver durable, premium-quality sneakers that keep you light,
          agile, and ready for anything your day brings.
        </p>
      </div>
      <br />
      <button class="btn light">Read more</button>
    </div>
  </div>
</section>

<!-- COLLECTION SECTION -->
<!-- NEW ARRIVALS SECTION (Ported from Home) -->
<section class="section products-section reveal" id="collection">
  <div class="container">
    <div class="section-header" style="text-align: center; margin-bottom: 3rem;">
      <p class="band-label" style="color: var(--accent); letter-spacing: 0.25em; font-weight: 600;">FEATURED</p>
      <h2 style="font-family: silver; font-size: 3rem; color: var(--text-light);">NEW ARRIVALS</h2>
      <p style="font-size: 1.05rem; color: var(--text-light); opacity: 0.7; font-weight: 300; margin-top: 0.5rem;">
        Freshly dropped — shop the latest additions to our collection</p>
    </div>

    <div class="products-grid-home">
      <% if (typeof newArrivals !=='undefined' && newArrivals.length> 0) { %>
        <% newArrivals.forEach((product, index)=> { %>
          <div class="home-product-card" style="animation-delay: <%= index * 0.1 %>s">
            <div class="home-product-image" onclick="window.location.href='/user/product-details/<%= product._id %>'">
              <img src="<%= product.productImage[0] %>" alt="<%= product.productName %>" />
              <div class="home-card-overlay"></div>
              <span class="home-badge-new">NEW</span>
              <% if (product.salePrice < product.regularPrice) { %>
                <% const discount=Math.round(((product.regularPrice - product.salePrice) / product.regularPrice) * 100);
                  %>
                  <span class="home-badge-discount">-<%= discount %>%</span>
                  <% } %>
                    <div class="home-card-actions">
                      <button class="home-action-btn" onclick="event.stopPropagation(); addToCart('<%= product._id %>')"
                        title="Add to Bag">
                        <i class="fas fa-shopping-bag"></i>
                      </button>
                      <button class="home-action-btn" title="Wishlist">
                        <i class="far fa-heart"></i>
                      </button>
                    </div>
            </div>
            <div class="home-product-details">
              <span class="home-product-category">
                <%= product.category ? product.category.name : 'Sneakers' %>
              </span>
              <h3 class="home-product-name" onclick="window.location.href='/user/product-details/<%= product._id %>'">
                <%= product.productName %>
              </h3>
              <div class="home-product-pricing">
                <span class="home-current-price">₹<%= product.salePrice.toLocaleString('en-IN') %></span>
                <% if (product.salePrice < product.regularPrice) { %>
                  <span class="home-original-price">₹<%= product.regularPrice.toLocaleString('en-IN') %></span>
                  <% } %>
              </div>
            </div>
          </div>
          <% }) %>
            <% } else { %>
              <div class="home-empty-state">
                <i class="fas fa-box-open"></i>
                <p>No new arrivals at the moment.</p>
                <span>Check back soon for fresh drops!</span>
              </div>
              <% } %>
    </div>

    <div class="section-footer" style="text-align: center; margin-top: 2rem;">
      <a href="/user/shop" class="btn outline view-all-btn">
        View All Products <i class="fas fa-arrow-right"></i>
      </a>
    </div>
  </div>
</section>

<!-- TESTIMONIAL SECTION -->
<section class="section band testimonial-band" id="testimonials">
  <div class="container testimonial-inner">
    <div class="testimonial-left">
      <p class="band-label">TESTIMONIAL</p>
      <h2>HEAR FROM OUR PEOPLE</h2>
      <div class="rating-pill">
        <div class="rating-big">4.5</div>
        <div class="rating-text">
          <p>Rating</p>
          <p>Trusted by 2000+ customers</p>
        </div>
      </div>
    </div>

    <div class="testimonial-right">
      <div class="testimonial-card">
        <p class="testimonial-quote">
          “These sneakers feel amazing. The cushioning, grip, and design all
          work together. I can wear them the whole day without getting
          tired.”
        </p>
        <div class="testimonial-user">
          <img src="/user/images/person.jpg" alt="User" />
          <div>
            <h4>Akram Ali</h4>
            <p>Verified customer</p>
          </div>
        </div>
      </div>
      <br /><br />
      <div class="testimonial-card">
        <p class="testimonial-quote">
          “These sneakers feel amazing. The cushioning, grip, and design all
          work together. I can wear them the whole day without getting
          tired.”
        </p>
        <div class="testimonial-user">
          <img src="/user/images/person.jpg" alt="User" />
          <div>
            <h4>Vignesh Muthu</h4>
            <p>Verified customer</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="/user/js/landing.js" defer></script>
<link rel="stylesheet" href="/user/css/shop.css" />

<section class="page-header">
  <div class="container">
    <h1 class="page-title">EXPLORE COLLECTION</h1>
    <p class="page-subtitle">Discover premium sneakers that match your style</p>
  </div>
</section>

<section class="products-main-section">
  <div class="container">
    <div class="products-layout">

      <aside class="products-sidebar">
        <div class="sidebar-sticky">
          <button class="filter-toggle" id="filterToggle">
            <i class="fas fa-filter"></i>
            <span>Filters</span>
          </button>

          <div class="sidebar-content" id="sidebarContent">
            <div class="filter-section">
              <h3 class="filter-title"><i class="fas fa-th-large"></i> Categories</h3>
              <ul class="category-list">
                <li class="category-item <%= !selectedCategory ? 'active' : '' %>"
                  onclick="setCategory('')">
                  <span class="category-name">All Products</span>
                </li>
                <% categories.forEach(cat=> { %>
                  <li class="category-item <%= String(selectedCategory) === String(cat._id) ? 'active' : '' %>"
                    onclick="setCategory('<%= cat._id %>')">
                    <span class="category-name">
                      <%= cat.name %>
                    </span>
                  </li>
                  <% }) %>
              </ul>
            </div>

            <div class="filter-section">
              <h3 class="filter-title"><i class="fas fa-rupee-sign"></i> Price Range</h3>
              <div class="price-inputs">
                <div class="price-range-display">
                  ₹<span id="minPriceDisplay">
                    <%= minPrice %>
                  </span> - ₹<span id="maxPriceDisplay">
                    <%= maxPrice %>
                  </span>
                </div>
              </div>
              <div class="dual-range-slider">
                <div class="slider-track"></div>
                <input type="range" id="minPriceRange" min="0" max="20000" step="100" value="<%= minPrice %>"
                  oninput="updatePriceLabels()">
                <input type="range" id="maxPriceRange" min="0" max="20000" step="100" value="<%= maxPrice %>"
                  oninput="updatePriceLabels()">
              </div>
            </div>

            <div class="filter-section">
              <h3 class="filter-title"><i class="fas fa-ruler-combined"></i> Sizes</h3>
              <div class="size-grid">
                <% availableSizes.forEach(size=> { %>
                  <button class="size-btn <%= selectedSize === size ? 'active' : '' %>"
                    onclick="toggleSize('<%= size %>')">
                    <%= size %>
                  </button>
                  <% }) %>
              </div>
            </div>

            <button class="btn outline clear-filters" onclick="window.location.href='/user/shop'">
              <i class="fas fa-redo"></i> Clear All Filters
            </button>
          </div>
        </div>
      </aside>

      <main class="products-content">
        <div class="products-toolbar">
          <div class="toolbar-left">
            <p class="results-count">Showing <span>
                <%= products.length %>
              </span> products</p>
          </div>
          <div class="toolbar-right">
            <div class="product-search">
              <input type="text" id="searchInput" placeholder="Search sneakers..."
                value="<%= typeof search !== 'undefined' ? search : '' %>">
              <button id="clearSearchBtn" onclick="clearSearch()">
                <i class="fas fa-times"></i>
              </button>
              <button onclick="applyFilters()"><i class="fas fa-search"></i></button>
            </div>
            <div class="sort-dropdown">
              <select id="sortSelect" class="sort-select" onchange="applyFilters()">
                <option value="newest" <%=selectedSort==='newest' ? 'selected' : '' %>>Sort: Newest First</option>
                <option value="price-low" <%=selectedSort==='price-low' ? 'selected' : '' %>>Sort: Price Low to High
                </option>
                <option value="price-high" <%=selectedSort==='price-high' ? 'selected' : '' %>>Sort: Price High to Low
                </option>
                <option value="a-z" <%=selectedSort==='a-z' ? 'selected' : '' %>>Sort: A - Z</option>
                <option value="z-a" <%=selectedSort==='z-a' ? 'selected' : '' %>>Sort: Z - A</option>
              </select>
            </div>
          </div>
        </div>

        <div class="products-grid" id="productsGrid">
          <% if (products && products.length> 0) { %>
            <% products.forEach(product=> { %>
              <% const isUnavailable = product.isBlocked || (product.category && !product.category.isListed); %>
              <div class="product-card <%= isUnavailable ? 'product-unavailable' : '' %>" data-product-id="<%= product._id %>" data-category-id="<%= product.category ? product.category._id : '' %>">
                <div class="product-image">
                  <% if (isUnavailable) { %>
                    <div class="unavailable-overlay">
                      <span class="unavailable-text">UNAVAILABLE</span>
                    </div>
                    <% } %>
                      <img src="<%= product.productImage[0] %>" alt="<%= product.productName %>" <% if
                        (!isUnavailable) { %>
                      onclick="window.location.href='/user/product-details/<%= product._id %>'" style="cursor:pointer;"
                        <% } %> />
                          <% if (!isUnavailable) { %>
                            <% const isInWishlist=typeof wishlistProductIds !=='undefined' &&
                              wishlistProductIds.includes(product._id.toString()); %>
                              <button class="wishlist-btn <%= isInWishlist ? 'active' : '' %>"
                                onclick="toggleWishlist(this, '<%= product._id %>')">
                                <i class="<%= isInWishlist ? 'fas' : 'far' %> fa-heart"></i>
                              </button>
                              <% } %>
                </div>
                <div class="product-info">
                  <h3 class="product-name" <% if (!isUnavailable) { %>
                    onclick="window.location.href='/user/product-details/<%= product._id %>'" style="cursor:pointer;"
                      <% } %>>
                        <%= product.productName %>
                  </h3>
                  <p class="product-category">
                    <%= product.category ? product.category.name : 'Uncategorized' %>
                  </p>
                  <div class="product-footer">
                    <% if (isUnavailable) { %>
                      <p class="product-price unavailable-price">Unavailable</p>
                      <% } else { %>
                        <p class="product-price">
                          <% if (product.salePrice < product.regularPrice) { %>
                            <span class="old-price">₹<%= product.regularPrice %></span>
                            <% } %>
                              ₹<%= product.salePrice %>
                        </p>
                        <button class="add-to-cart-btn btn-icon-circle"
                          onclick="window.location.href='/user/product-details/<%= product._id %>'">
                          <i class="fas fa-arrow-right"></i>
                        </button>
                        <% } %>
                  </div>
                </div>
              </div>
              <% }) %>
                <% } else { %>
                  <div class="empty-state" style="grid-column: 1/-1; text-align: center; padding: 3rem;">
                    <i class="fas fa-search" style="font-size: 3rem; color: #ccc; margin-bottom: 1rem;"></i>
                    <p>No sneakers found matching your criteria.</p>
                  </div>
                  <% } %>
        </div>

        <% if (Number(totalPages)>= 1) { %>
          <div class="pagination-wrapper">
            <div class="pagination">
              <% if (Number(currentPage)> 1) { %>
                <button class="page-btn" onclick="navigateToPage('<%= Number(currentPage) - 1 %>')">
                  <i class="fas fa-chevron-left"></i>
                </button>
                <% } %>

                  <% let startPage=Math.max(1, Number(currentPage) - 2); let endPage=Math.min(Number(totalPages),
                    startPage + 4); if (endPage - startPage < 4) { startPage=Math.max(1, endPage - 4); } %>

                    <% if (startPage> 1) { %>
                      <button class="page-btn" onclick="navigateToPage('1')">1</button>
                      <% if (startPage> 2) { %><span class="page-dots">...</span>
                        <% } %>
                          <% } %>

                            <% for(let i=startPage; i <=endPage; i++) { %>
                              <button class="page-btn <%= Number(currentPage) === i ? 'active' : '' %>"
                                onclick="navigateToPage('<%= i %>')">
                                <%= i %>
                              </button>
                              <% } %>

                                <% if (endPage < Number(totalPages)) { %>
                                  <% if (endPage < Number(totalPages) - 1) { %><span class="page-dots">...</span>
                                    <% } %>
                                      <button class="page-btn" onclick="navigateToPage('<%= Number(totalPages) %>')">
                                        <%= totalPages %>
                                      </button>
                                      <% } %>

                                        <% if (Number(currentPage) < Number(totalPages)) { %>
                                          <button class="page-btn"
                                            onclick="navigateToPage('<%= Number(currentPage) + 1 %>')">
                                            <i class="fas fa-chevron-right"></i>
                                          </button>
                                          <% } %>
            </div>
            <div class="pagination-info">
              Showing page <span>
                <%= currentPage %>
              </span> of <span>
                <%= totalPages %>
              </span>
            </div>
          </div>
          <% } %>
      </main>
    </div>
  </div>
</section>

<script>
  let debounceTimer;

  // Dual Range Slider Logic
  const minSlider = document.getElementById('minPriceRange');
  const maxSlider = document.getElementById('maxPriceRange');
  const minDisplay = document.getElementById('minPriceDisplay');
  const maxDisplay = document.getElementById('maxPriceDisplay');
  const track = document.querySelector('.slider-track');

  function updatePriceLabels() {
    let minVal = parseInt(minSlider.value);
    let maxVal = parseInt(maxSlider.value);

    if (maxVal - minVal < 1000) {
      if (event && event.target === minSlider) {
        minSlider.value = maxVal - 1000;
        minVal = maxVal - 1000;
      } else {
        maxSlider.value = minVal + 1000;
        maxVal = minVal + 1000;
      }
    }

    minDisplay.innerText = minVal;
    maxDisplay.innerText = maxVal;
    fillTrack();
  }

  function fillTrack() {
    const minPercent = (minSlider.value / minSlider.max) * 100;
    const maxPercent = (maxSlider.value / maxSlider.max) * 100;
    track.style.background = `linear-gradient(to right, #ddd ${minPercent}%, var(--accent) ${minPercent}%, var(--accent) ${maxPercent}%, #ddd ${maxPercent}%)`;
  }

  // Category click handler
  function setCategory(catId) {
    window.selectedCategoryOverride = catId;
    navigateToPage(1);
  }

  function toggleSize(size) {
    const currentSize = '<%= selectedSize %>';
    const newSize = (currentSize === size) ? '' : size;
    window.selectedSizeOverride = newSize;
    navigateToPage(1);
  }

  // Optimized Navigation Function
  function navigateToPage(pageNumber) {
    const search = document.getElementById('searchInput').value;
    const sort = document.getElementById('sortSelect').value;
    const minPrice = document.getElementById('minPriceRange').value;
    const maxPrice = document.getElementById('maxPriceRange').value;
    
    const size = window.selectedSizeOverride !== undefined ? window.selectedSizeOverride : '<%= selectedSize %>';
    const category = window.selectedCategoryOverride !== undefined ? window.selectedCategoryOverride : '<%= selectedCategory %>';

    let url = `/user/shop?page=${pageNumber}&sort=${sort}&minPrice=${minPrice}&maxPrice=${maxPrice}`;
    if (size && size !== 'undefined' && size !== 'null') url += `&size=${size}`;
    if (category && category !== 'undefined' && category !== 'null') url += `&category=${category}`;
    if (search) url += `&search=${encodeURIComponent(search)}`;

    window.location.href = url;
  }

  minSlider.onchange = () => applyFilters();
  maxSlider.onchange = () => applyFilters();
  fillTrack();

  function applyFilters() {
    navigateToPage(1); // Always reset to page 1 when filtering
  }

  function toggleClearButton() {
    const input = document.getElementById('searchInput');
    const clearBtn = document.getElementById('clearSearchBtn');
    if (input && clearBtn) {
      clearBtn.style.display = input.value.length > 0 ? 'block' : 'none';
    }
  }

  function clearSearch() {
    const input = document.getElementById('searchInput');
    if (input) {
      input.value = '';
      toggleClearButton();
      applyFilters();
    }
  }

  // Bind Enter key and Input event
  const searchInput = document.getElementById('searchInput');
  if (searchInput) {
    searchInput.addEventListener('keypress', function (e) {
      if (e.key === 'Enter') {
        applyFilters();
      }
    });
    searchInput.addEventListener('input', toggleClearButton);
  }

  // Initial check
  document.addEventListener('DOMContentLoaded', toggleClearButton);

  window.addEventListener("pageshow", function (event) {
    if (event.persisted || (typeof window.performance != "undefined" && window.performance.navigation.type === 2)) {
      window.location.reload();
    }
  });

  async function toggleWishlist(btn, productId) {
    const isActive = btn.classList.contains('active');
    const url = isActive ? `/user/wishlist/remove/${productId}` : '/user/wishlist/add';
    const method = isActive ? 'DELETE' : 'POST';
    const body = isActive ? {} : { productId };

    try {
      const response = await fetch(url, {
        method: method,
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(body)
      });

      if (response.status === 401) {
        window.location.href = '/user/login';
        return;
      }

      const result = await response.json();

      if (result.success) {
        Swal.fire({
          icon: 'success',
          title: 'Wishlist',
          text: result.message,
          toast: true,
          position: 'top-end',
          showConfirmButton: false,
          timer: 3000
        });

        // Update Wishlist Count
        const wishlistBadge = document.querySelector('.nav-icon[title="Wishlist"] .nav-badge');
        if (wishlistBadge) {
          let current = parseInt(wishlistBadge.textContent) || 0;
          wishlistBadge.textContent = isActive ? Math.max(0, current - 1) : current + 1;
        }

        // Toggle Visual State
        const icon = btn.querySelector('i');
        if (isActive) {
          btn.classList.remove('active');
          if (icon) {
            icon.classList.remove('fas');
            icon.classList.add('far');
          }
        } else {
          btn.classList.add('active');
          if (icon) {
            icon.classList.remove('far');
            icon.classList.add('fas');
          }
        }

      } else {
        if (result.message === 'Login required') {
          window.location.href = '/user/login';
        } else {
          Swal.fire({
            icon: 'info',
            text: result.message,
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000
          });
        }
      }
    } catch (error) {
      console.error('Wishlist error:', error);
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: 'Something went wrong',
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 3000
      });
    }
  }
</script>
<link rel="stylesheet" href="/user/css/shop.css" />
<link rel="stylesheet" href="/user/css/wishlist.css" />

<section class="page-header">
    <div class="container">
        <h1 class="page-title">WISHLIST</h1>
        <p class="page-subtitle">Your saved favourites — all in one place</p>
    </div>
</section>

<section class="wishlist-section">
    <div class="container">
        <% if (wishlistItems && wishlistItems.length> 0) { %>

            <!-- TOOLBAR -->
            <div class="wishlist-toolbar">
                <div class="toolbar-left">
                    <p class="results-count"><span>
                            <%= wishlistItems.length %>
                        </span> items saved</p>
                </div>
                <div class="toolbar-right">
                    <button class="btn outline" onclick="clearWishlist()"><i class="fas fa-trash"></i> Clear
                        All</button>
                </div>
            </div>

            <!-- PRODUCTS GRID -->
            <div class="products-grid" id="wishlistGrid">
                <% wishlistItems.forEach((item, index)=> { %>
                    <!-- Use product-card structure from Shop -->
                    <div class="product-card <%= item.productId.isBlocked ? 'product-unavailable' : '' %>" id="wishlist-item-<%= item.productId._id %>" data-product-id="<%= item.productId._id %>" data-category-id="<%= item.productId.category ? item.productId.category._id : '' %>">
                        <div class="product-image">
                            <% if (item.productId.isBlocked) { %>
                                <div class="unavailable-overlay">
                                    <span class="unavailable-text">UNAVAILABLE</span>
                                </div>
                            <% } %>
                            <img src="<%= item.productId.productImage[0] %>" alt="<%= item.productId.productName %>"
                                <% if (!item.productId.isBlocked) { %>
                                onclick="window.location.href='/user/product-details/<%= item.productId._id %>'"
                                style="cursor:pointer;"
                                <% } %> />

                            <!-- Wishlist Button (Always Active here) -->
                            <button class="wishlist-btn active"
                                onclick="toggleWishlist(this, '<%= item.productId._id %>')">
                                <i class="fas fa-heart"></i>
                            </button>
                        </div>
                        <div class="product-info">
                            <h3 class="product-name"
                                <% if (!item.productId.isBlocked) { %>
                                onclick="window.location.href='/user/product-details/<%= item.productId._id %>'"
                                style="cursor:pointer;"
                                <% } %>>
                                <%= item.productId.productName %>
                            </h3>
                            <p class="product-category">
                                <%= item.productId.category ? item.productId.category.name : 'Uncategorized' %>
                            </p>
                            <div class="product-footer">
                                <% if (item.productId.isBlocked) { %>
                                    <p class="product-price unavailable-price">Unavailable</p>
                                <% } else { %>
                                    <!-- Variant Selection Dropdown -->
                                    <div class="wishlist-variant-selector" style="margin-bottom: 8px;">
                                        <select id="variant-select-<%= item.productId._id %>" class="form-select"
                                            style="width: 100%; padding: 4px; font-size: 0.85rem; border-radius: 4px; border: 1px solid #ddd;">
                                            <option value="" disabled selected>Select Size</option>
                                            <% if (item.productId.variants && item.productId.variants.length> 0) { %>
                                                <% item.productId.variants.forEach(variant=> { %>
                                                    <option value="<%= variant.size %>" <%=variant.quantity===0 ? 'disabled'
                                                        : '' %>>
                                                        Size <%= variant.size %>
                                                            <% if (variant.quantity> 0 && variant.quantity <= 5) { %>
                                                                    (Only <%= variant.quantity %> left)
                                                                        <% } else if (variant.quantity===0) { %>
                                                                            (Out of Stock)
                                                                            <% } %>
                                                    </option>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <option value="" disabled>No variants available</option>
                                                            <% } %>
                                        </select>
                                    </div>
                                    <div style="display: flex; justify-content: space-between; align-items: center;">
                                        <p class="product-price" style="margin: 0;">
                                            <% if (item.productId.salePrice < item.productId.regularPrice) { %>
                                                <span class="old-price">₹<%= item.productId.regularPrice %></span>
                                                <% } %>
                                                    ₹<%= item.productId.salePrice %>
                                        </p>
                                        <button class="add-to-cart-btn btn-icon-circle"
                                            onclick="addToCartFromWishlist('<%= item.productId._id %>')"
                                            <%=item.productId.quantity===0 ? 'disabled' : '' %>>
                                            <i class="fas fa-arrow-right"></i>
                                        </button>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <% }) %>
            </div>

            <% } else { %>
                <!-- EMPTY STATE -->
                <div class="wishlist-empty">
                    <i class="fas fa-heart"></i>
                    <h2>Nothing saved yet</h2>
                    <p>Start adding sneakers you love</p>
                    <a href="/user/shop" class="btn primary">Browse Collection</a>
                </div>
                <% } %>
    </div>
</section>

<!-- Inline script for toggle logic specific to Wishlist page (removes element) -->
<script>
    async function toggleWishlist(btn, productId) {
        // On wishlist page, we only support removing.
        // But for consistency with the shop page logic, we check active state.
        // Here, it should always be active initially.

        try {
            const response = await fetch(`/user/wishlist/remove/${productId}`, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' }
            });

            const result = await response.json();

            if (result.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Removed',
                    text: 'Item removed from wishlist',
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 2000
                });

                // Remove the card from DOM
                const card = document.getElementById(`wishlist-item-${productId}`);
                if (card) {
                    card.style.transition = 'all 0.3s ease';
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.9)';
                    setTimeout(() => {
                        card.remove();
                        // Update count or reload if empty?
                        // Simple way: check if grid is empty
                        const grid = document.getElementById('wishlistGrid');
                        if (grid && grid.children.length === 0) {
                            location.reload();
                        }
                    }, 300);
                }
                // Update Wishlist Count in nav
                const wishlistBadge = document.querySelector('.nav-icon[title="Wishlist"] .nav-badge');
                if (wishlistBadge) {
                    let current = parseInt(wishlistBadge.textContent) || 0;
                    wishlistBadge.textContent = Math.max(0, current - 1);
                }
            } else {
                Swal.fire({
                    icon: 'error',
                    text: result.message
                });
            }
        } catch (error) {
            console.error(error);
        }
    }
</script>

<script src="/user/js/wishlist.js" defer></script>